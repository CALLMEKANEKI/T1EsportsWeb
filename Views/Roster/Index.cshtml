@model IEnumerable<T1EsportsWeb.Models.Player>

@{
    ViewData["Title"] = "Đội Hình T1";
}

<div class="text-center w-100 mt-5">
    <h1 style="color: #e3002b; font-weight: bold; font-size: 3rem; text-transform: uppercase;">T1 - 2026 - DOFPK</h1>
    <p style="color: #e5b344; font-size: 1.2rem; letter-spacing: 2px;">LIMITLESS</p>

    <div class="row row-cols-1 row-cols-md-5 g-4 mt-4 px-3 px-xl-5">
        @foreach (var player in Model)
        {
            <div class="col">
                <div class="card t1-player-card h-100 shadow-lg" style="background-color: #1a1a1a; border: 1px solid #333;">
                    <img src="@player.ImageUrl" asp-append-version="true" class="card-img-top" alt="@player.IngameName" style="height: 500px; object-fit: cover; object-position: top center; border-bottom: 2px solid #e3002b;">

                    <div class="card-body d-flex flex-column p-4 text-center">
                        <h2 class="card-title fw-bold" style="color: #fff; font-size: 2rem;">@player.IngameName</h2>
                        <h5 class="card-text text-danger mb-3 fw-bold">@player.Role</h5>
                        <p class="card-text" style="color: #e5b344; margin-bottom: 25px; font-size: 1.1rem;">Tướng tủ: @player.SignatureChampion</p>

                        <a asp-controller="Roster" asp-action="Details" asp-route-id="@player.Id" class="btn btn-outline-danger btn-lg mt-auto fw-bold" style="border-width: 2px;">XEM CHI TIẾT</a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>