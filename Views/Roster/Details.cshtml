@model T1EsportsWeb.Models.Player

@{
    ViewData["Title"] = "Chi tiết tuyển thủ - " + Model.IngameName;
}

<div class="container mt-4">
    <a asp-action="Index" class="btn btn-outline-light mb-4">< Về danh sách đội hình</a>

    <div class="row">
        <div class="col-md-4">
            <div class="card t1-player-card mb-4" style="background-color: #1a1a1a; border-color: #e3002b;">
                <img src="@Model.ImageUrl" class="card-img-top" alt="@Model.IngameName" style="height: 400px; object-fit: cover; border-bottom: 2px solid #e3002b;">
                <div class="card-body text-center">
                    <h2 class="card-title fw-bold" style="color: #fff;">@Model.IngameName</h2>
                    <h5 class="text-danger">@Model.Role</h5>
                    <hr style="border-color: #555;" />
                    <div class="text-start" style="color: #ccc;">
                        <p><strong>Tên thật:</strong> Lee Sang-hyeok</p>
                        <p><strong>Quốc tịch:</strong> Hàn Quốc</p>
                        <p><strong>Tướng tủ:</strong> <span style="color: #e5b344;">@Model.SignatureChampion</span></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <ul class="nav nav-tabs custom-t1-tabs" id="playerTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="dashboard-tab" data-bs-toggle="tab" data-bs-target="#dashboard" type="button" role="tab">DASHBOARD</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="pro-tab" data-bs-toggle="tab" data-bs-target="#pro" type="button" role="tab">LỊCH SỬ LCK/CKTG</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="soloq-tab" data-bs-toggle="tab" data-bs-target="#soloq" type="button" role="tab">XẾP HẠNG (SOLO Q)</button>
                </li>
            </ul>

            <div class="tab-content mt-4" id="playerTabContent" style="color: white;">

                <div class="tab-pane fade show active" id="dashboard" role="tabpanel">
                    <div class="row text-center">
                        <div class="col-md-4">
                            <div class="p-3 mb-3" style="background-color: #222; border-radius: 8px; border-left: 4px solid #e3002b;">
                                <h5>Tỉ lệ thắng mùa này</h5>
                                <h3 style="color: #e5b344;">68.5%</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 mb-3" style="background-color: #222; border-radius: 8px; border-left: 4px solid #00a8ff;">
                                <h5>KDA Trung bình</h5>
                                <h3 style="color: #00a8ff;">4.2</h3>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="p-3 mb-3" style="background-color: #222; border-radius: 8px; border-left: 4px solid #4cd137;">
                                <h5>Sát thương / Phút</h5>
                                <h3 style="color: #4cd137;">580</h3>
                            </div>
                        </div>
                    </div>
                    <div class="mt-4 p-4 text-center" style="background-color: #111; border-radius: 8px; border: 1px dashed #555;">
                        <p class="text-muted">[Khu vực dành cho Biểu đồ Radar thống kê kỹ năng]</p>
                    </div>
                </div>

                <div class="tab-pane fade" id="pro" role="tabpanel">
                    <table class="table table-dark table-hover text-center" style="border-radius: 8px; overflow: hidden;">
                        <thead style="background-color: #e3002b;">
                            <tr>
                                <th>Ngày</th>
                                <th>Giải đấu</th>
                                <th>Đối thủ</th>
                                <th>Kết quả</th>
                                <th>KDA</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>15/03/2026</td>
                                <td>LCK Mùa Xuân</td>
                                <td>Gen.G</td>
                                <td class="text-success fw-bold">WIN</td>
                                <td>5/1/8 (Azir)</td>
                            </tr>
                            <tr>
                                <td>10/03/2026</td>
                                <td>LCK Mùa Xuân</td>
                                <td>KT Rolster</td>
                                <td class="text-danger fw-bold">LOSS</td>
                                <td>2/4/3 (Orianna)</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="tab-pane fade" id="soloq" role="tabpanel">
                    <div class="d-flex align-items-center justify-content-between p-3 mb-2" style="background-color: #1e2328; border-left: 5px solid #00a8ff; border-radius: 5px;">
                        <div class="d-flex align-items-center">
                            <img src="https://ddragon.leagueoflegends.com/cdn/14.5.1/img/champion/Hwei.png" alt="Hwei" style="width: 50px; height: 50px; border-radius: 50%;">
                            <div class="ms-3">
                                <h5 class="mb-0 fw-bold text-info">Chiến thắng</h5>
                                <small class="text-muted">Rank Thách Đấu - 20 phút trước</small>
                            </div>
                        </div>
                        <div class="text-center">
                            <h5 class="mb-0">8 / 2 / 12</h5>
                            <small class="text-muted">KDA: 10.0</small>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>