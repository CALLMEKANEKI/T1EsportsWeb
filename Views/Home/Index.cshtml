@{
    ViewData["Title"] = "Trang chủ";
}

<div class="hero-banner text-center d-flex align-items-end justify-content-center pb-5">
    <div class="hero-content mb-4">
        <a asp-controller="Roster" asp-action="Index" class="btn btn-danger btn-lg" style="background-color: #e3002b; border: none; padding: 12px 35px; font-weight: bold; letter-spacing: 1px; transition: 0.3s; box-shadow: 0 5px 15px rgba(227, 0, 43, 0.4);">
            KHÁM PHÁ ĐỘI HÌNH
        </a>
    </div>
</div>

<div class="container mt-5 pt-5 text-center">
    <h2 style="color: #fff; font-weight: bold; margin-bottom: 30px;">TẠI SAO LẠI LÀ T1?</h2>
    <div class="row">
        <div class="col-md-4">
            <h4 style="color: #e3002b;">Vô Địch Thế Giới</h4>
            <p style="color: #aaa;">Đội tuyển duy nhất sở hữu 6 chức vô địch Chung Kết Thế Giới, khẳng định vị thế đế chế LOL eSports số 1.</p>
        </div>
        <div class="col-md-4">
            <h4 style="color: #e3002b;">Faker - Quỷ Vương</h4>
            <p style="color: #aaa;">Sở hữu tuyển thủ vĩ đại nhất mọi thời đại, người truyền cảm hứng cho hàng triệu game thủ.</p>
        </div>
        <div class="col-md-4">
            <h4 style="color: #e3002b;">DOFPK - Gắn Kết</h4>
            <p style="color: #aaa;">Đội hình trẻ trung, tài năng và sự gắn kết phi thường: Doran, Oner, Faker, Peyz, Keria.</p>
        </div>
    </div>
</div>