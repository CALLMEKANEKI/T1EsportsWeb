@model IEnumerable<T1EsportsWeb.Models.T1Stat.DTO.MatchHistoryDto>

@{
    ViewData["Title"] = "Lịch sử đấu";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public string GetTeamColor(string teamName)
    {
        if (string.IsNullOrEmpty(teamName)) return "#ffffff";
        var name = teamName.ToLower();
        if (name.Contains("t1")) return "#e3002b";
        if (name.Contains("hanwha") || name.Contains("hle")) return "#ff6b00";
        if (name.Contains("gen") || name.Contains("geng")) return "#aa8a00";
        if (name.Contains("dplus") || name.Contains("dk")) return "#00b2a9";
        if (name.Contains("kt")) return "#ff0000";
        if (name.Contains("drx")) return "#5a8dff";
        if (name.Contains("kdf")) return "#e05c20";
        if (name.Contains("jdg")) return "#e03e3e";
        if (name.Contains("blg")) return "#00a1d6";
        if (name.Contains("tes")) return "#e60012";
        if (name.Contains("fly")) return "#004f2f";
        return "#a1a5b7";
    }
}

<style>
    body {
        background-color: #05050a;
        color: #fff;
    }

    .glass-panel {
        background: #1e1e2d;
        border-radius: 16px;
        border: 1px solid #2b2b40;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .custom-select, .custom-input {
        background-color: #151521;
        border: 1px solid #2b2b40;
        color: #fff;
        border-radius: 8px;
    }

        .custom-select:focus, .custom-input:focus {
            background-color: #151521;
            border-color: #22c55e;
            color: #fff;
            box-shadow: none;
        }

        .custom-input::-webkit-calendar-picker-indicator {
            filter: invert(1);
            cursor: pointer;
            opacity: 0.8;
            transition: 0.2s;
        }

            .custom-input::-webkit-calendar-picker-indicator:hover {
                opacity: 1;
            }

    .series-card {
        background: linear-gradient(145deg, #1a1a24, #111119);
        border: 1px solid rgba(255,255,255,0.05);
        border-radius: 12px;
        overflow: hidden;
        transition: 0.3s;
        margin-bottom: 20px;
    }

        .series-card:hover {
            border-color: #22c55e;
            box-shadow: 0 8px 25px rgba(34, 197, 94, 0.15);
        }

    .series-header {
        background: rgba(0,0,0,0.2);
        padding: 15px 20px;
        border-bottom: 1px solid #2b2b40;
        transition: 0.3s;
    }

        .series-header:hover {
            background: rgba(34, 197, 94, 0.05);
        }

    .champion-tooltip {
        position: relative;
        display: inline-block;
    }

        .champion-tooltip .tooltiptext {
            visibility: hidden;
            width: 100px;
            background-color: rgba(0,0,0,0.9);
            color: #fff;
            text-align: center;
            border-radius: 4px;
            padding: 5px;
            position: absolute;
            z-index: 10;
            bottom: 110%;
            left: 50%;
            margin-left: -50px;
            opacity: 0;
            transition: opacity 0.2s;
            font-size: 0.75rem;
        }

        .champion-tooltip:hover .tooltiptext {
            visibility: visible;
            opacity: 1;
        }

    .side-blue-text {
        color: #3b82f6 !important;
        font-weight: bold;
    }

    .side-red-text {
        color: #ef4444 !important;
        font-weight: bold;
    }

    .team-header-left {
        border-left: 4px solid #3b82f6;
        padding-left: 10px;
    }

    .team-header-right {
        border-right: 4px solid #ef4444;
        padding-right: 10px;
        text-align: right;
    }

    .vs-divider {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        position: relative;
    }

    .vs-line {
        width: 1px;
        flex-grow: 1;
        background: #444;
    }

    .vs-circle {
        width: 35px;
        height: 35px;
        border: 1px solid #444;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #1a1a1a;
        font-size: 0.7rem;
        color: #888;
        margin: 10px 0;
    }

    .lane-icon {
        width: 18px;
        height: 18px;
        opacity: 0.8;
        filter: brightness(1.2);
    }

    .champion-img {
        width: 50px;
        height: 50px;
        border-radius: 8px;
        border: 2px solid #2b2b40;
        object-fit: cover;
        background-color: #000;
    }

    .ban-img {
        width: 32px;
        height: 32px;
        border-radius: 4px;
        object-fit: cover;
        filter: grayscale(0.6);
        border: 1px solid #444;
    }

    .cursor-pointer {
        cursor: pointer;
    }
</style>

<div class="container-fluid py-4">

    <div class="text-center mb-5 pb-4 pt-3 border-bottom" style="border-color: rgba(34, 197, 94, 0.4) !important;">
        <h1 class="d-flex justify-content-center align-items-center flex-wrap mb-0" style="font-size: 3.5rem; font-weight: 900; letter-spacing: 4px;">
            <span style="color: #22c55e; text-shadow: 0 0 15px rgba(34, 197, 94, 0.8), 3px 3px 6px rgba(0,0,0,0.9);">LỊCH SỬ ĐẤU</span>
        </h1>

        <p class="mt-3 mb-0" style="font-size: 1.5rem; color: #ddd; font-weight: bold; text-shadow: 2px 2px 4px rgba(0,0,0,0.9);">
            Tra cứu chi tiết kết quả, cấm/chọn và thông số các trận đấu
        </p>
    </div>

    <div class="glass-panel">
        <form method="get" class="row g-3 align-items-end" id="filterForm">
            <div class="col-md-3">
                <label for="startDate" class="form-label small fw-bold text-muted"><i class="far fa-calendar-alt me-1"></i>TỪ NGÀY</label>
                <input type="date" class="form-control custom-input" id="startDate" name="startDate" value="@ViewBag.StartDate" />
            </div>
            <div class="col-md-3">
                <label for="endDate" class="form-label small fw-bold text-muted"><i class="far fa-calendar-check me-1"></i>ĐẾN NGÀY</label>
                <input type="date" class="form-control custom-input" id="endDate" name="endDate" value="@ViewBag.EndDate" />
            </div>
            <div class="col-md-4">
                <label for="tournamentId" class="form-label small fw-bold text-muted"><i class="fas fa-trophy me-1"></i>GIẢI ĐẤU</label>
                <select class="form-select custom-select" id="tournamentId" name="tournamentId">
                    <option value="">-- Tất cả giải đấu --</option>
                    @if (ViewBag.Tournaments != null)
                    {
                        foreach (var t in ViewBag.Tournaments)
                        {
                            <option value="@t.IdTournament" selected="@(ViewBag.SelectedTournament == t.IdTournament ? "selected" : null)">
                                @t.Name (@t.Year)
                            </option>
                        }
                    }
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100 fw-bold py-2" style="box-shadow: 0 4px 15px rgba(34, 197, 94, 0.4);">
                    <i class="fas fa-search me-1"></i> LỌC
                </button>
            </div>
        </form>
    </div>

    <div id="seriesList">
        @if (Model != null && Model.Any())
        {
            int matchCount = 0; // Biến đếm số lượng trận đấu
            foreach (var series in Model)
            {
                // Vượt quá 5 trận (series) sẽ ẩn đi
                var displayClass = matchCount >= 5 ? "d-none hidden-series" : "visible-series";

                <div class="series-card @displayClass" id="card-series-@series.SeriesId">
                    <div class="series-header d-flex justify-content-between align-items-center cursor-pointer" onclick="$('#series-@series.SeriesId').collapse('toggle')">
                        <div class="d-flex align-items-center">
                            <span class="badge bg-dark border border-secondary text-light px-3 py-2 me-3 fs-6">
                                <i class="far fa-clock me-1"></i> @series.MatchDate.ToString("dd/MM/yyyy")
                            </span>
                            <span class="fw-bold fs-4 me-3 text-white">
                                <span style="color: #e3002b; text-shadow: 0 0 10px currentColor;">T1</span>
                                <span class="text-muted mx-2 fs-5">vs</span>
                                <span style="color: @GetTeamColor(series.OpponentName); text-shadow: 0 0 10px currentColor;">@series.OpponentName</span>
                            </span>
                            <span class="badge @(series.Result == "Win" ? "bg-success" : "bg-danger") px-3 py-2 fs-6 shadow-sm me-3">@series.Result</span>
                            <span class="text-info fw-semibold"><i class="fas fa-trophy me-1"></i>@series.TournamentName</span>
                        </div>
                        <i class="fas fa-chevron-down text-muted fs-4"></i>
                    </div>

                    <div id="series-@series.SeriesId" class="collapse show">
                        <div class="p-0">
                            <table class="table table-dark table-hover mb-0" style="background: transparent;">
                                <thead style="background-color: #2b2b40;">
                                    <tr class="text-muted small text-uppercase">
                                        <th class="ps-4">Ván Đấu</th>
                                        <th>Phiên Bản</th>
                                        <th>Đội Hình</th>
                                        <th>Kết Quả</th>
                                        <th>Xem Lại (VOD)</th>
                                        <th class="text-end pe-4">Thao Tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var game in series.Games)
                                    {
                                        <tr style="border-bottom: 1px solid #2b2b40;">
                                            <td class="ps-4 fw-bold">Game @game.GameNumber</td>
                                            <td class="text-muted">@game.Patch</td>
                                            <td class="@(game.Side == "Blue" ? "side-blue-text" : "side-red-text")"><i class="fas fa-flag me-1"></i>@game.Side</td>
                                            <td>
                                                @if (game.Result == "Win")
                                                {
                                                    <span class="badge bg-soft-success text-success border border-success"><i class="fas fa-check-circle me-1"></i>Win</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-soft-danger text-danger border border-danger"><i class="fas fa-times-circle me-1"></i>Loss</span>
                                                }
                                            </td>
                                            <td>
                                                @if (!string.IsNullOrEmpty(game.Link))
                                                {
                                                    <a href="@game.Link" target="_blank" class="btn btn-sm btn-outline-danger px-3 rounded-pill shadow-sm">
                                                        <i class="fab fa-youtube me-1"></i>YouTube
                                                    </a>
                                                }
                                                else
                                                {
                                                    <button class="btn btn-sm btn-outline-secondary px-3 rounded-pill opacity-50" disabled>
                                                        <i class="fas fa-video-slash me-1"></i>No VOD
                                                    </button>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                <button class="btn btn-sm btn-info text-white fw-bold px-3 rounded-pill shadow-sm" onclick="loadGameDetails(@game.GameId, '@game.Side', this)">
                                                    <i class="fas fa-info-circle me-1"></i>Chi tiết
                                                </button>
                                            </td>
                                        </tr>
                                        <tr style="border: none;">
                                            <td colspan="6" class="p-0 border-0">
                                                <div id="game-detail-@game.GameId" style="display: none;">
                                                    <div class="p-4" style="background: #111119; box-shadow: inset 0 5px 15px rgba(0,0,0,0.5);">
                                                        <div class="row mb-4 align-items-center">
                                                            <div class="col-5">
                                                                <div id="left-bans-@game.GameId" class="d-flex gap-2"></div>
                                                            </div>
                                                            <div class="col-2 text-center text-muted small fw-bold text-uppercase" style="letter-spacing: 2px;">CẤM (BANS)</div>
                                                            <div class="col-5">
                                                                <div id="right-bans-@game.GameId" class="d-flex gap-2 justify-content-end"></div>
                                                            </div>
                                                        </div>
                                                        <div class="row">
                                                            <div class="col-5">
                                                                <div id="left-team-label-@game.GameId" class="mb-3"></div>
                                                                <div id="left-lineup-@game.GameId" class="d-flex flex-column gap-2"></div>
                                                            </div>
                                                            <div class="col-2">
                                                                <div class="vs-divider">
                                                                    <div class="vs-line"></div>
                                                                    <div class="vs-circle text-danger fw-bold shadow" style="border-color: #e3002b;">VS</div>
                                                                    <div class="vs-line"></div>
                                                                </div>
                                                            </div>
                                                            <div class="col-5 text-end">
                                                                <div id="right-team-label-@game.GameId" class="mb-3"></div>
                                                                <div id="right-lineup-@game.GameId" class="d-flex flex-column gap-2 align-items-end"></div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                matchCount++;
            }

            // Hiển thị nút Tải Thêm nếu có nhiều hơn 5 trận
            @if (Model.Count() > 5)
            {
                <div class="text-center mt-4 mb-5" id="loadMoreContainer">
                    <button id="btnLoadMore" class="btn btn-outline-success fw-bold rounded-pill px-5 py-2 shadow-sm" style="transition: 0.3s;">
                        <i class="fas fa-chevron-down me-2"></i> TẢI THÊM 5 TRẬN
                    </button>
                </div>
            }
        }
        else
        {
            <div class="glass-panel text-center py-5">
                <i class="fas fa-folder-open fa-4x text-muted mb-3 opacity-50"></i>
                <h4 class="text-muted">Không tìm thấy trận đấu nào khớp với bộ lọc.</h4>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        const laneIcons = {
            "TOP": "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-top.png",
            "JUNGLE": "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-jungle.png",
            "MID": "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-middle.png",
            "ADC": "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-bottom.png",
            "SUPPORT": "https://raw.communitydragon.org/latest/plugins/rcp-fe-lol-clash/global/default/assets/images/position-selector/positions/icon-position-utility.png"
        };

        const fallbackChampImg = 'https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/champion-icons/-1.png';
        const fallbackPlayerImg = 'https://raw.communitydragon.org/latest/plugins/rcp-be-lol-game-data/global/default/v1/profile-icons/0.jpg';

        async function loadGameDetails(gameId, t1Side, button) {
            const detailContainer = document.getElementById('game-detail-' + gameId);
            const $container = $(detailContainer);

            if ($container.is(':visible')) {
                $container.slideUp(250);
                button.innerHTML = '<i class="fas fa-info-circle me-1"></i>Chi tiết';
                return;
            }

            button.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

            if (detailContainer.getAttribute('data-loaded') === 'true') {
                $container.slideDown(250);
                button.innerHTML = '<i class="fas fa-eye-slash me-1"></i>Đóng';
                return;
            }

            try {
                const res = await fetch(`/MatchHistory/GetGameDetails?gameId=${gameId}`);
                const data = await res.json();

                const isT1Left = (t1Side === 'Blue');
                const roles = ["TOP", "JUNGLE", "MID", "ADC", "SUPPORT"];

                document.getElementById(`left-team-label-${gameId}`).className = `team-header-left side-blue-text`;
                document.getElementById(`left-team-label-${gameId}`).innerHTML = `<small>BLUE SIDE</small><br><span class="fs-5">${isT1Left ? 'T1' : 'OPPONENT'}</span>`;

                document.getElementById(`right-team-label-${gameId}`).className = `team-header-right side-red-text`;
                document.getElementById(`right-team-label-${gameId}`).innerHTML = `<small>RED SIDE</small><br><span class="fs-5">${!isT1Left ? 'T1' : 'OPPONENT'}</span>`;

                let leftLineupHtml = '';
                let rightLineupHtml = '';
                const leftPlayers = isT1Left ? data.t1Lineup : data.opponentLineup;
                const rightPlayers = isT1Left ? data.opponentLineup : data.t1Lineup;

                leftPlayers.forEach((p, i) => leftLineupHtml += renderPlayerStr(p, 'left', roles[i]));
                rightPlayers.forEach((p, i) => rightLineupHtml += renderPlayerStr(p, 'right', roles[i]));

                document.getElementById(`left-lineup-${gameId}`).innerHTML = leftLineupHtml;
                document.getElementById(`right-lineup-${gameId}`).innerHTML = rightLineupHtml;

                let leftBansHtml = '';
                let rightBansHtml = '';
                data.bans.forEach(ban => {
                    const banImgSrc = ban.championImageUrl || fallbackChampImg;
                    const imgHtml = `<div class="champion-tooltip shadow-sm">
                                        <img src="${banImgSrc}" class="ban-img" onerror="this.onerror=null; this.src='${fallbackChampImg}'">
                                        <span class="tooltiptext">${ban.championName || 'Unknown'}</span>
                                     </div>`;
                    const isT1Ban = (ban.teamName === "T1");
                    if (isT1Left) {
                        isT1Ban ? leftBansHtml += imgHtml : rightBansHtml += imgHtml;
                    } else {
                        isT1Ban ? rightBansHtml += imgHtml : leftBansHtml += imgHtml;
                    }
                });
                document.getElementById(`left-bans-${gameId}`).innerHTML = leftBansHtml;
                document.getElementById(`right-bans-${gameId}`).innerHTML = rightBansHtml;

                detailContainer.setAttribute('data-loaded', 'true');
                $container.slideDown(250);
                button.innerHTML = '<i class="fas fa-eye-slash me-1"></i>Đóng';
            } catch (e) {
                button.innerHTML = '<i class="fas fa-exclamation-triangle me-1"></i>Lỗi';
            }
        }

        function renderPlayerStr(p, align, role) {
            const isRight = align === 'right';
            const safeRole = role || "UNKNOWN";
            const champImgUrl = p.championImageUrl || fallbackChampImg;
            const playerImgUrl = p.playerPhotoUrl || fallbackPlayerImg;
            const laneIconStr = laneIcons[safeRole] ? `<img src="${laneIcons[safeRole]}" class="lane-icon">` : '';

            return `
            <div class="d-flex align-items-center gap-2 py-1 ${isRight ? 'flex-row-reverse text-end' : 'text-start'}" style="width: 100%;">
                <div class="d-flex align-items-center position-relative ${isRight ? 'flex-row-reverse' : ''}" style="width: 60px;">
                    <div class="champion-tooltip shadow">
                        <img src="${champImgUrl}" class="champion-img" onerror="this.onerror=null; this.src='${fallbackChampImg}'">
                        <span class="tooltiptext">${p.championName || 'Unknown'}</span>
                    </div>
                    <img src="${playerImgUrl}" class="rounded-circle shadow-sm"
                         style="width: 32px; height: 32px; object-fit: cover; border: 2px solid #111119; position: absolute; ${isRight ? 'left: -8px;' : 'right: -8px;'} bottom: -5px; z-index: 2;"
                         onerror="this.onerror=null; this.src='${fallbackPlayerImg}'">
                </div>

                <div style="min-width: 120px;" class="${isRight ? 'me-2' : 'ms-2'}">
                    <div class="d-flex align-items-center gap-2 ${isRight ? 'justify-content-end' : ''}">
                        ${!isRight ? laneIconStr : ''}
                        <span class="fw-bold text-white" style="font-size: 0.95rem;">${p.playerName || 'Unknown'}</span>
                        ${isRight ? laneIconStr : ''}
                    </div>
                    <div class="text-muted" style="font-size: 0.75rem; font-weight: 500;">${p.championName || 'Unknown'}</div>
                </div>
            </div>`;
        }

        // =====================================
        // XỬ LÝ NÚT XEM THÊM (LOAD MORE)
        // =====================================
        $(document).ready(function() {
            let currentVisible = 5;
            const step = 5; //Nhớ sửa lại

            $('#btnLoadMore').click(function() {
                const $btn = $(this);
                const originalText = $btn.html();

                $btn.html('<i class="fas fa-spinner fa-spin me-2"></i> ĐANG TẢI...');
                $btn.prop('disabled', true);

                setTimeout(() => {
                    $('.hidden-series').slice(0, step).removeClass('d-none hidden-series').hide().fadeIn(500);
                    currentVisible += step;

                    if ($('.hidden-series').length === 0) {
                        $('#loadMoreContainer').fadeOut();
                    }
                    
                    $btn.html(originalText);
                    $btn.prop('disabled', false);
                }, 400);
            });
        });
    </script>
}