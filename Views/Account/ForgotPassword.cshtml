@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Khôi phục mật khẩu - T1 ESPORTS</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

    <style>
        .vng-dark-input {
            background-color: #111 !important;
            border: 2px solid #444;
            border-radius: 8px;
            padding: 18px 20px;
            color: #ffffff !important;
            font-weight: bold;
            font-size: 1.1rem;
            transition: 0.3s;
        }

            .vng-dark-input:focus {
                border-color: #e3002b !important;
                box-shadow: none !important;
                outline: none !important;
            }

            .vng-dark-input::placeholder {
                color: #777 !important;
                font-weight: 800;
                text-transform: uppercase;
                font-size: 1rem;
            }

        .arrow-submit-btn {
            background-color: #e3002b;
            color: white;
            border: none;
            border-radius: 25px;
            width: 90px;
            height: 90px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 2.5rem;
            transition: 0.3s;
        }

            .arrow-submit-btn:hover {
                background-color: #ff1a40;
                transform: scale(1.05);
                box-shadow: 0 0 25px rgba(227, 0, 43, 0.6);
            }

        .forgot-password-link {
            color: #aaa;
            font-size: 1.1rem;
            font-weight: bold;
            text-decoration: none;
            transition: 0.3s;
        }

            .forgot-password-link:hover {
                color: #e3002b;
                text-decoration: underline;
            }
    </style>
</head>
<body style="background-color: #000; overflow-x: hidden;">

    <div class="row g-0" style="height: 100vh;">

        <div class="col-md-8 d-none d-md-block" style="background: url('/images/T1 Skin CTKG.jpg') no-repeat center center; background-size: cover;">
            <div style="background-color: rgba(0, 0, 0, 0.2); width: 100%; height: 100%;"></div>
        </div>

        <div class="col-md-4 d-flex flex-column align-items-center py-4" style="background-color: #111; border-left: 1px solid #333; position: relative;">

            <div class="w-100 d-flex justify-content-between align-items-center px-4">
                <img src="~/images/t1-logo.png" alt="T1 Logo" style="height: 130px;">
                <a asp-controller="Account" asp-action="Login" class="text-muted" style="text-decoration: none; font-weight: bold; font-size: 1.2rem;">
                    ✕ Hủy
                </a>
            </div>

            <div class="w-100 px-4 px-xl-5 mt-5" style="max-width: 550px;">

                <div class="text-center mb-5">
                    <h2 style="color: #fff; font-weight: 900; text-transform: uppercase; letter-spacing: 2px; font-size: 2.5rem;">QUÊN MẬT KHẨU</h2>
                    <p class="text-muted mt-2">Nhập Username và Email để đặt lại mật khẩu</p>
                </div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger text-center fw-bold py-3" style="font-size: 1rem;" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post" class="text-start">

                    <div class="mb-4">
                        <input type="text" name="username" class="form-control w-100 vng-dark-input" required placeholder="USERNAME">
                    </div>

                    <div class="mb-5">
                        <input type="email" name="email" class="form-control w-100 vng-dark-input" required placeholder="EMAIL ĐÃ ĐĂNG KÝ">
                    </div>

                    <div class="text-center mt-5">
                        <button type="submit" class="arrow-submit-btn" title="Khôi phục mật khẩu">
                            <i class="fas fa-check"></i>
                        </button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</body>
</html>