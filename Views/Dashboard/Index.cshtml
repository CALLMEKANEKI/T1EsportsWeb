@{
    ViewData["Title"] = "Dashboard Thống Kê T1";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* 💎 ĐỒNG BỘ GIAO DIỆN GLASSMORPHISM VÀ DARK THEME */
    .dashboard-bg {
        background-color: #05050a;
        color: #fff;
    }

    .glass-panel {
        background: #1e1e2d;
        border-radius: 16px;
        border: 1px solid #2b2b40;
        padding: 24px;
        margin-bottom: 24px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.2);
    }

    .panel-title {
        font-size: 1.1rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #fff;
        margin-bottom: 20px;
        border-bottom: 2px solid #2b2b40;
        padding-bottom: 10px;
    }

    /* 💎 STATS CARDS CHUYÊN NGHIỆP */
    .stat-card {
        background: linear-gradient(145deg, #1a1a24, #111119);
        border-radius: 16px;
        border: 1px solid rgba(255,255,255,0.05);
        padding: 1.5rem;
        position: relative;
        overflow: hidden;
        transition: 0.3s;
        height: 100%;
    }

        .stat-card:hover {
            transform: translateY(-5px);
            border-color: #e3002b;
            box-shadow: 0 10px 20px rgba(227, 0, 43, 0.15);
        }

    .stat-icon {
        position: absolute;
        right: -10px;
        bottom: -15px;
        font-size: 5rem;
        opacity: 0.05;
        color: #e3002b;
    }

    .stat-value {
        font-size: 2.5rem;
        font-weight: 900;
        line-height: 1;
        margin-bottom: 8px;
    }

    .stat-label {
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #a1a5b7;
        font-weight: bold;
    }

    /* FORM & BẢNG */
    .custom-select, .custom-input {
        background-color: #151521;
        border: 1px solid #2b2b40;
        color: #fff;
        border-radius: 8px;
    }

        .custom-select:focus, .custom-input:focus {
            background-color: #151521;
            border-color: #e3002b;
            color: #fff;
            box-shadow: none;
        }

    .chart-container {
        overflow-x: auto;
        width: 100%;
    }

        .chart-container canvas {
            height: 350px;
        }

    .table-t1 th {
        background-color: #2b2b40;
        color: #a1a5b7;
        font-size: 0.85rem;
        text-transform: uppercase;
        border: none;
    }

    .table-t1 td {
        border-bottom: 1px solid #2b2b40;
        vertical-align: middle;
    }

    }
</style>

<div class="container-fluid py-4 dashboard-bg">

    <div class="text-center mb-5 border-bottom border-danger pb-4 pt-3">
        <h1 class="d-flex justify-content-center align-items-center flex-wrap mb-0" style="font-size: 3.5rem; font-weight: 900; letter-spacing: 4px;">
            <span style="color: #e3002b; text-shadow: 0 0 15px rgba(227, 0, 43, 0.8), 3px 3px 6px rgba(0,0,0,0.9);">T1 PERFORMANCE DASHBOARD</span>
        </h1>
    </div>
    @*Filter *@
    <div class="glass-panel">
        <h6 class="fw-bold text-muted mb-3"><i class="fas fa-filter me-2"></i>BỘ LỌC DỮ LIỆU TỔNG QUAN</h6>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">GIẢI ĐẤU</label>
                <select id="tournamentFilter" class="form-select custom-select">
                    <option value="">Tất cả giải đấu</option>
                    @foreach (var t in ViewBag.Tournaments)
                    {
                        <option value="@t.IdTournament">@t.Name (@t.Year)</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">ĐỐI THỦ</label>
                <select id="opponentFilter" class="form-select custom-select">
                    <option value="">Tất cả đối thủ</option>
                    @foreach (var o in ViewBag.Opponents)
                    {
                        <option value="@o.IdTeam">@o.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">TỪ NGÀY</label>
                <input type="date" id="startDate" class="form-control custom-input" />
            </div>
            <div class="col-md-3">
                <label class="form-label small fw-bold text-muted">ĐẾN NGÀY</label>
                <input type="date" id="endDate" class="form-control custom-input" />
            </div>
        </div>
    </div>

    @*Card*@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-label">DOMESTIC SERIES (Quốc Nội)</div>
                <div class="stat-value text-primary" id="domesticSeries">-</div>
                <i class="fas fa-flag stat-icon text-primary"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-label">INTERNATIONAL SERIES (Quốc Tế)</div>
                <div class="stat-value text-warning" id="internationalSeries">-</div>
                <i class="fas fa-globe-americas stat-icon text-warning"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-label">TOTAL GAMES (Tổng Số Ván)</div>
                <div class="stat-value text-success" id="totalGames">-</div>
                <i class="fas fa-gamepad stat-icon text-success"></i>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="stat-card">
                <div class="stat-label mb-2">THỐNG KÊ THỂ THỨC</div>
                <div id="boStats" class="row text-center mt-3 position-relative" style="z-index: 1;">
                    <div class="text-muted small">Đang tải...</div>
                </div>
                <i class="fas fa-layer-group stat-icon text-info"></i>
            </div>
        </div>
    </div>

    @*Chart*@
    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <div class="glass-panel h-100 mb-0">
                <div class="panel-title"><i class="fas fa-chart-bar text-danger me-2"></i>Tổng Series Theo Giải Đấu</div>
                <div class="chart-container">
                    <canvas id="seriesChart"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div>
        <div class="col-lg-12">
            <div class="glass-panel h-100 mb-0">
                <div class="panel-title"><i class="fas fa-chart-line text-warning me-2"></i>Tổng Ván Đấu Theo Giải</div>
                <div class="chart-container">
                    <canvas id="gamesChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-4">
            <div class="glass-panel h-100 mb-0">
                <div class="panel-title"><i class="fas fa-adjust text-info me-2"></i>Tỉ Lệ Thắng Đội Xanh / Đỏ</div>
                <div style="position: relative; height: 300px; width: 100%;">
                    <canvas id="sideDonutChart"></canvas>
                </div>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="glass-panel h-100 mb-0">
                <div class="d-flex justify-content-between align-items-center border-bottom border-secondary pb-2 mb-3">
                    <div class="panel-title border-0 mb-0 pb-0"><i class="fas fa-users text-success me-2"></i>Tỉ Lệ Thắng Tuyển Thủ Theo Vị Trí</div>
                    <select id="roleFilter" class="form-select custom-select w-auto py-1">
                        <option value="">Tất cả Vị trí</option>
                        <option value="Top">Top</option>
                        <option value="Jungle">Jungle</option>
                        <option value="Mid" selected>Mid</option>
                        <option value="ADC">ADC</option>
                        <option value="Support">Support</option>
                    </select>
                </div>
                <div class="chart-container">
                    <canvas id="playerChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <div class="glass-panel">
                <div class="panel-title"><i class="fas fa-code-branch text-primary me-2"></i>Phong Độ Theo Phiên Bản (Patch)</div>
                <div class="chart-container" style="overflow-x: auto; width: 100%;">
                    <canvas id="winrateByPatchChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-12">
            <div class="glass-panel">
                <div class="panel-title"><i class="fas fa-fist-raised text-danger me-2"></i>Thành Tích Đối Đầu (Head-to-Head)</div>
                <div style="overflow-x: auto; width: 100%;">
                    <div class="chart-container" style="overflow-x: auto; width: 100%;">
                        <canvas id="headToHeadChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="glass-panel mb-5">
        <div class="panel-title mb-4"><i class="fas fa-mask text-warning me-2"></i>THỐNG KÊ CHAMPIONS</div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">LỌC GIẢI ĐẤU</label>
                <select id="champTournamentFilter" class="form-select custom-select">
                    <option value="">Tất cả giải đấu</option>
                    @foreach (var t in ViewBag.Tournaments)
                    {
                        <option value="@t.IdTournament">@t.Name (@t.Year)</option>
                    }
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label small fw-bold text-muted">LỌC ĐỐI THỦ</label>
                <select id="champOpponentFilter" class="form-select custom-select">
                    <option value="">Tất cả đối thủ</option>
                    @foreach (var o in ViewBag.Opponents)
                    {
                        <option value="@o.IdTeam">@o.Name</option>
                    }
                </select>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <h5 class="fw-bold text-danger mb-3">T1 CHAMPIONS</h5>
                <div id="t1Loading" class="text-center py-4" style="display: none;">
                    <i class="fas fa-circle-notch fa-spin fa-2x text-danger"></i><br>Đang tải dữ liệu...
                </div>
                <div class="table-responsive" style="max-height: 400px; border-radius: 8px; border: 1px solid #2b2b40;">
                    <table class="table table-dark table-hover table-t1 mb-0" id="t1ChampionTable">
                        <thead style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th>Champion</th>
                                <th class="text-center">Picks</th>
                                <th class="text-center">Bans</th>
                                <th class="text-center text-success">Wins</th>
                                <th class="text-center text-danger">Win Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="5" class="text-center py-4 text-muted">-- Chưa có dữ liệu --</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="col-md-6">
                <h5 class="fw-bold text-info mb-3">OPPONENT CHAMPIONS</h5>
                <div id="oppLoading" class="text-center py-4" style="display: none;">
                    <i class="fas fa-circle-notch fa-spin fa-2x text-info"></i><br>Đang tải dữ liệu...
                </div>
                <div class="table-responsive" style="max-height: 400px; border-radius: 8px; border: 1px solid #2b2b40;">
                    <table class="table table-dark table-hover table-t1 mb-0" id="opponentChampionTable">
                        <thead style="position: sticky; top: 0; z-index: 1;">
                            <tr>
                                <th>Champion</th>
                                <th class="text-center">Picks</th>
                                <th class="text-center">Bans</th>
                                <th class="text-center text-success">Wins</th>
                                <th class="text-center text-danger">Win Rate</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr><td colspan="5" class="text-center py-4 text-muted">-- Chọn đối thủ để xem thống kê --</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        Chart.defaults.color = '#a1a5b7';
        Chart.defaults.scale.grid.color = 'rgba(255, 255, 255, 0.05)';
        Chart.defaults.plugins.legend.labels.color = '#fff';

        let seriesChart, gamesChart, winrateChart, sideChart, playerChart, headToHeadChart;

        function getFilterParams() {
            return {
                tournamentId: document.getElementById('tournamentFilter').value || null,
                opponentId: document.getElementById('opponentFilter').value || null,
                startDate: document.getElementById('startDate').value || null,
                endDate: document.getElementById('endDate').value || null
            };
        }

        async function loadSideChart() {
            try {
                const res = await fetch('/Dashboard/Overview');
                if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
                const data = await res.json();

                document.getElementById('domesticSeries').innerText = data.domesticSeriesCount;
                document.getElementById('internationalSeries').innerText = data.internationalSeriesCount;
                document.getElementById('totalGames').innerText = data.totalGames;
                // 🎯 Trình bày lại số liệu thành 3 cột (col-4) có vách ngăn
                document.getElementById('boStats').innerHTML = `
                    <div class="col-4 border-end border-secondary px-0">
                        <div class="text-info fw-bold" style="font-size: 1.8rem; line-height: 1;">${data.bo3Count}</div>
                        <div class="text-muted small fw-bold mt-1">BO3</div>
                    </div>
                    <div class="col-4 border-end border-secondary px-0">
                        <div class="text-info fw-bold" style="font-size: 1.8rem; line-height: 1;">${data.bo5Count}</div>
                        <div class="text-muted small fw-bold mt-1">BO5</div>
                    </div>
                    <div class="col-4 px-0">
                        <div class="text-info fw-bold" style="font-size: 1.8rem; line-height: 1;">${data.bo1Count}</div>
                        <div class="text-muted small fw-bold mt-1">BO1</div>
                    </div>
                `;

                const blueWins = data.blueWins;
                const blueLosses = data.blueGames - blueWins;
                const redWins = data.redWins;
                const redLosses = data.redGames - redWins;

                const ctx = document.getElementById('sideDonutChart').getContext('2d');
                if (window.sideDonutChart && typeof window.sideDonutChart.destroy === 'function') {
                    window.sideDonutChart.destroy();
                }
                window.sideDonutChart = new Chart(ctx, {
                    type: 'doughnut',
                    data: {
                        labels: ['Blue Wins', 'Blue Losses', 'Red Wins', 'Red Losses'],
                        datasets: [{
                            data: [blueWins, blueLosses, redWins, redLosses],
                            backgroundColor: ['#0d6efd', '#2c3e50', '#dc3545', '#4a1c1c'],
                            borderWidth: 2,
                            borderColor: '#1e1e2d'
                        }]
                    },
                    options: {
                        responsive: true, maintainAspectRatio: false,
                        plugins: { legend: { position: 'bottom' } },
                        cutout: '65%'
                    }
                });
            } catch (error) { console.error('Error loading side chart:', error); }
        }

        async function loadSeriesByTournament() {
            const params = getFilterParams();
            const query = new URLSearchParams(params).toString();
            const res = await fetch(`/Dashboard/SeriesByTournament?${query}`);
            const data = await res.json();

            const labels = data.map(d => `${d.tournamentName} (${d.year})`);
            const krWon = data.map(d => d.krWon);
            const krLost = data.map(d => d.krLost);
            const intWon = data.map(d => d.intWon);
            const intLost = data.map(d => d.intLost);
            const winRates = data.map(d => d.winRate);

            const canvas = document.getElementById('seriesChart');
            // Đặt kích thước canvas dựa trên số lượng label (mỗi label 80px)
            const chartWidth = Math.max(800, labels.length * 80);
            canvas.width = chartWidth;
            canvas.style.width = `${chartWidth}px`;
            canvas.height = 500;
            canvas.style.height = '500px';

            const ctx = canvas.getContext('2d');
            if (seriesChart) seriesChart.destroy();

            seriesChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        { label: 'KR Won', data: krWon, backgroundColor: '#e3002b', stack: 'series' },
                        { label: 'KR Lost', data: krLost, backgroundColor: '#7a1020', stack: 'series' },
                        { label: 'INT Won', data: intWon, backgroundColor: '#0d6efd', stack: 'series' },
                        { label: 'INT Lost', data: intLost, backgroundColor: '#1a3b6e', stack: 'series' },
                        {
                            label: 'Win Rate (%)', data: winRates, type: 'line',
                            borderColor: '#22c55e', backgroundColor: '#22c55e',
                            yAxisID: 'y1', tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            ticks: {
                                maxRotation: 90,
                                minRotation: 90,
                                autoSkip: false
                            }
                        },
                        y: { stacked: true, title: { display: true, text: 'Số lượng Series' } },
                        y1: { position: 'right', max: 100, title: { display: true, text: 'Win Rate (%)' }, grid: { drawOnChartArea: false } }
                    }
                }
            });
        }

        async function loadGamesByTournament() {
            try {
                const params = getFilterParams();
                const query = new URLSearchParams(params).toString();
                const res = await fetch(`/Dashboard/GamesByTournament?${query}`);
                if (!res.ok) throw new Error(`HTTP ${res.status}`);
                const data = await res.json();

                if (!data || data.length === 0) return;

                const labels = data.map(d => `${d.tournamentName} (${d.year})`);
                const winRates = data.map(d => d.winRate);
                const krWon = data.map(d => d.gamesKRWon);
                const krLost = data.map(d => d.gamesKRLost);
                const intWon = data.map(d => d.gamesINTWon);
                const intLost = data.map(d => d.gamesINTLost);

                const canvas = document.getElementById('gamesChart');
                // Đặt kích thước canvas dựa trên số lượng label
                const chartWidth = Math.max(800, labels.length * 80);
                canvas.width = chartWidth;
                canvas.style.width = `${chartWidth}px`;
                canvas.height = 500;
                canvas.style.height = '500px';

                const ctx = canvas.getContext('2d');
                if (gamesChart) gamesChart.destroy();

                gamesChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [
                            { label: 'KR Won', data: krWon, backgroundColor: '#e3002b', stack: 'total' },
                            { label: 'KR Lost', data: krLost, backgroundColor: '#7a1020', stack: 'total' },
                            { label: 'INT Won', data: intWon, backgroundColor: '#0d6efd', stack: 'total' },
                            { label: 'INT Lost', data: intLost, backgroundColor: '#1a3b6e', stack: 'total' },
                            {
                                label: 'Win Rate (%)', data: winRates, type: 'line',
                                borderColor: '#ffc107', backgroundColor: '#ffc107',
                                tension: 0.3, yAxisID: 'y1'
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                            ticks: {
                                maxRotation: 90,
                                minRotation: 90,
                                autoSkip: false
                            }
                        },
                            y: { stacked: true, title: { display: true, text: 'Số Ván đấu' } },
                            y1: { position: 'right', max: 100, title: { display: true, text: 'Win Rate (%)' }, grid: { drawOnChartArea: false } }
                        }
                    }
                });
            } catch (error) { console.error('Error loading games chart:', error); }
        }

        async function loadWinrateByPatch() {
            const params = getFilterParams();
            const query = new URLSearchParams(params).toString();
            const res = await fetch(`/Dashboard/WinrateByPatch?${query}`);
            const data = await res.json();

            const labels = data.map(d => d.patch);
            // Mỗi patch ước lượng 60px, tối thiểu 800px
            const chartWidth = Math.max(800, labels.length * 60);

            const canvas = document.getElementById('winrateByPatchChart');
            canvas.width = chartWidth;
            canvas.style.width = `${chartWidth}px`;
            canvas.height = 300;
            canvas.style.height = '300px';

            const ctx = canvas.getContext('2d');
            if (winrateChart) winrateChart.destroy();
            winrateChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Win Rate (%)',
                        data: data.map(d => d.winRate),
                        borderColor: '#0dcaf0',
                        backgroundColor: 'rgba(13, 202, 240, 0.1)',
                        fill: true,
                        tension: 0.4,
                        borderWidth: 3,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            ticks: {
                                maxRotation: 90,
                                minRotation: 90,
                                autoSkip: false
                            }
                        },
                        y: { beginAtZero: true, max: 100 }
                    }
                }
            });
        }

        async function loadPlayerWinrate() {
            try {
                const role = document.getElementById('roleFilter').value;
                const params = getFilterParams();
                params.role = role || null;
                const query = new URLSearchParams(params).toString();
                const res = await fetch(`/Dashboard/PlayerWinrate?${query}`);
                if (!res.ok) throw new Error(`HTTP error! status: ${res.status}`);
                const data = await res.json();

                if (!Array.isArray(data)) return;

                const ctx = document.getElementById('playerChart').getContext('2d');
                if (playerChart) playerChart.destroy();
                playerChart = new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: data.map(p => p.playerName),
                        datasets: [{
                            label: 'Win Rate (%)', data: data.map(p => p.winRate),
                            backgroundColor: '#20c997', borderRadius: 4, barPercentage: 0.5
                        }]
                    },
                    options: { 
                        responsive: true, maintainAspectRatio: false, scales: { y: { beginAtZero: true, max: 100 } } }
                });
            } catch (error) { console.error('Error loading player winrate:', error); }
        }

        async function loadHeadToHead() {
            const params = getFilterParams();
            const query = new URLSearchParams(params).toString();
            const res = await fetch(`/Dashboard/HeadToHead?${query}`);
            const data = await res.json();

            const labels = data.map(d => d.opponentName);
            // Mỗi tên đội ước lượng 80px, tối thiểu 800px
            const chartWidth = Math.max(800, labels.length * 80);

            const canvas = document.getElementById('headToHeadChart');
            canvas.width = chartWidth;
            canvas.style.width = `${chartWidth}px`;
            canvas.height = 350;
            canvas.style.height = '350px';

            const ctx = canvas.getContext('2d');
            if (headToHeadChart) headToHeadChart.destroy();
            headToHeadChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Domestic WR (%)',
                            data: data.map(d => d.domesticWinRate),
                            backgroundColor: '#0d6efd',
                            borderRadius: 4
                        },
                        {
                            label: 'International WR (%)',
                            data: data.map(d => d.internationalWinRate),
                            backgroundColor: '#e3002b',
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        x: {
                            ticks: {
                                maxRotation: 90,
                                minRotation: 90,
                                autoSkip: false
                            }
                        },
                        y: { beginAtZero: true, max: 100 }
                    }
                }
            });
        }
        async function loadChampionStats() {
            const tournamentId = document.getElementById('champTournamentFilter')?.value || '';
            const opponentId = document.getElementById('champOpponentFilter')?.value || '';

            const t1Loading = document.getElementById('t1Loading');
            const oppLoading = document.getElementById('oppLoading');
            if (t1Loading) t1Loading.style.display = 'block';
            if (oppLoading) oppLoading.style.display = 'block';

            try {
                let t1Url = `/Dashboard/ChampionStats?type=T1&tournamentId=${tournamentId}`;
                if (opponentId) t1Url += `&opponentId=${opponentId}`;
                const t1Res = await fetch(t1Url);
                const t1Data = await t1Res.json();
                renderChampionTable(t1Data, '#t1ChampionTable');

                if (opponentId) {
                    const oppUrl = `/Dashboard/ChampionStats?type=Opponent&tournamentId=${tournamentId}&opponentId=${opponentId}`;
                    const oppRes = await fetch(oppUrl);
                    const oppData = await oppRes.json();
                    renderChampionTable(oppData, '#opponentChampionTable');
                } else {
                    const oppTbody = document.querySelector('#opponentChampionTable tbody');
                    if (oppTbody) oppTbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Vui lòng chọn Đối thủ để xem thống kê</td></tr>';
                }
            } catch (error) {
                console.error('Error loading champ stats:', error);
            } finally {
                if (t1Loading) t1Loading.style.display = 'none';
                if (oppLoading) oppLoading.style.display = 'none';
            }
        }

        function renderChampionTable(data, tableId) {
            const tbody = document.querySelector(`${tableId} tbody`);
            if (!tbody) return;
            if (!data || data.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="text-center py-4 text-muted">Không có dữ liệu thi đấu</td></tr>';
                return;
            }
            tbody.innerHTML = '';
            data.forEach(c => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td class="fw-bold">${c.championName}</td>
                    <td class="text-center">${c.picks}</td>
                    <td class="text-center text-muted">${c.bans}</td>
                    <td class="text-center text-success fw-bold">${c.wins}</td>
                    <td class="text-center text-danger fw-bold">${c.winRate.toFixed(1)}%</td>
                `;
            });
        }

        function refreshAllCharts() {
            loadSeriesByTournament().catch(e => console.error(e));
            loadGamesByTournament().catch(e => console.error(e));
            loadWinrateByPatch().catch(e => console.error(e));
            loadPlayerWinrate().catch(e => console.error(e));
            loadHeadToHead().catch(e => console.error(e));
            loadChampionStats().catch(e => console.error(e));
        }

        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById('tournamentFilter').addEventListener('change', refreshAllCharts);
            document.getElementById('opponentFilter').addEventListener('change', refreshAllCharts);
            document.getElementById('startDate').addEventListener('change', refreshAllCharts);
            document.getElementById('endDate').addEventListener('change', refreshAllCharts);
            document.getElementById('roleFilter').addEventListener('change', loadPlayerWinrate);

            const champTournament = document.getElementById('champTournamentFilter');
            const champOpponent = document.getElementById('champOpponentFilter');
            if (champTournament) champTournament.addEventListener('change', loadChampionStats);
            if (champOpponent) champOpponent.addEventListener('change', loadChampionStats);

            loadSideChart();
            refreshAllCharts();
        });
    </script>
}