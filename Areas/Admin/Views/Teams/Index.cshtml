@model IEnumerable<T1EsportsWeb.Models.T1Stat.Team>

@{
    ViewData["Title"] = "Danh sách đội tuyển";
    

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchName = ViewBag.SearchName ?? "";
    string region = ViewBag.Region ?? "";
    bool? hasLogo = ViewBag.HasLogo;
}

<h1>Quản lý đội tuyển</h1>

<p>
    <a asp-area="Admin" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm mới</a>
</p>

<!-- Form lọc -->
<div class="row mb-3 g-2 align-items-end">
    <div class="col-md-3">
        <input type="text" name="searchName" class="form-control" placeholder="Tên đội..." value="@searchName" onchange="submitFilter()" />
    </div>
    <div class="col-md-2">
        <select name="region" class="form-control" onchange="submitFilter()">
            <option value="">-- Khu vực --</option>
            <option value="KR" selected="@(region == "KR")">KR</option>
            <option value="INT" selected="@(region == "INT")">INT</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="hasLogo" class="form-control" onchange="submitFilter()">
            <option value="">-- Lọc theo logo --</option>
            <option value="true" selected="@(hasLogo == true)">Có logo</option>
            <option value="false" selected="@(hasLogo == false)">Không logo</option>
        </select>
    </div>
    <div class="col-md-2">
        <a asp-area="Admin" asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-dark table-hover align-middle">
        <thead>
            <tr>
                <th>Tên đội</th>
                <th>Khu vực</th>
                <th>Logo</th>
                <th style="width: 200px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Region</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.LogoUrl))
                        {
                            <img src="@item.LogoUrl" alt="logo" style="max-height: 40px;" />
                        }
                        else
                        {
                            <span class="text-muted">Chưa có</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.IdTeam" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Sửa
                        </a>
                        <a asp-area="Admin" asp-action="Details" asp-route-id="@item.IdTeam" class="btn btn-sm btn-info">
                            <i class="fas fa-info-circle"></i> Chi tiết
                        </a>
                        <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.IdTeam" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@(currentPage - 1)"
                   asp-route-searchName="@searchName" asp-route-region="@region" asp-route-hasLogo="@hasLogo">«</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@i"
                       asp-route-searchName="@searchName" asp-route-region="@region" asp-route-hasLogo="@hasLogo">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@(currentPage + 1)"
                   asp-route-searchName="@searchName" asp-route-region="@region" asp-route-hasLogo="@hasLogo">»</a>
            </li>
        </ul>
    </nav>
}

<script>
    function submitFilter() {
        var url = new URL(window.location.href);
        var searchName = document.querySelector('input[name="searchName"]')?.value;
        if (searchName) url.searchParams.set('searchName', searchName);
        else url.searchParams.delete('searchName');

        var region = document.querySelector('select[name="region"]')?.value;
        if (region) url.searchParams.set('region', region);
        else url.searchParams.delete('region');

        var hasLogo = document.querySelector('select[name="hasLogo"]')?.value;
        if (hasLogo) url.searchParams.set('hasLogo', hasLogo);
        else url.searchParams.delete('hasLogo');

        window.location.href = url.pathname + url.search;
    }
</script>