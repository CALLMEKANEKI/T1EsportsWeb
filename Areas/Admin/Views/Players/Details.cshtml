@model T1EsportsWeb.Models.T1Stat.Player

@{
    ViewData["Title"] = "Chi Tiết Tuyển Thủ";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 600px;">
    <div class="card-header border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0 text-white"><i class="fas fa-id-card text-primary me-2"></i>Hồ Sơ Tuyển Thủ</h3>
        <span class="badge bg-secondary fs-6">ID: #@Model.IdPlayer</span>
    </div>
    <div class="card-body p-4 text-center">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@Model.IngameName" class="rounded-circle border border-danger p-1 mb-3 shadow" style="width: 150px; height: 150px; object-fit: cover;" />
        }
        else
        {
            <div class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center border border-2 border-dashed border-secondary mb-3" style="width: 150px; height: 150px;">
                <i class="fas fa-user text-muted fa-4x"></i>
            </div>
        }

        <h2 class="fw-bold text-white mb-1">@Model.IngameName</h2>
        <h5 class="text-muted mb-4">@Model.FullName</h5>

        <div class="row text-start bg-dark rounded p-3 mb-4 mx-2">
            <div class="col-6 mb-3">
                <span class="text-muted small fw-bold d-block">VỊ TRÍ</span>
                <span class="badge bg-soft-danger text-danger fs-6 mt-1 px-3 py-2"><i class="fas fa-gamepad me-1"></i>@Model.Position</span>
            </div>
            <div class="col-6 mb-3">
                <span class="text-muted small fw-bold d-block">ĐỘI TUYỂN</span>
                <span class="fs-5 text-warning fw-bold">@(Model.Team?.Name ?? "Tuyển thủ tự do")</span>
            </div>
            <div class="col-6">
                <span class="text-muted small fw-bold d-block">QUỐC GIA</span>
                <span class="fs-6">@(string.IsNullOrEmpty(Model.Country) ? "Chưa cập nhật" : Model.Country)</span>
            </div>
            <div class="col-6">
                <span class="text-muted small fw-bold d-block">NGÀY SINH</span>
                <span class="fs-6">@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</span>
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.IdPlayer" class="btn btn-info px-4 fw-bold text-white"><i class="fas fa-edit me-2"></i>Sửa</a>
            <a asp-action="Index" class="btn btn-outline-light px-4"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
        </div>
    </div>
</div>