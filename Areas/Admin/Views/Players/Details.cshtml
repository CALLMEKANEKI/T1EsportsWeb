@model T1EsportsWeb.Models.T1Stat.Player

@{
    ViewData["Title"] = "Chi tiết tuyển thủ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Chi tiết tuyển thủ</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h4 class="card-title">@Model.IngameName</h4>
        <dl class="row">
            <dt class="col-sm-4">Tên thật</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Vị trí</dt>
            <dd class="col-sm-8">@Model.Position</dd>

            <dt class="col-sm-4">Ngày sinh</dt>
            <dd class="col-sm-8">@Model.BirthDate?.ToString("dd/MM/yyyy")</dd>

            <dt class="col-sm-4">Quốc gia</dt>
            <dd class="col-sm-8">@Model.Country</dd>

            <dt class="col-sm-4">Ảnh</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                {
                    <img src="@Model.PhotoUrl" alt="photo" style="max-height: 100px;" />
                }
                else
                {
                    <span class="text-muted">Chưa có</span>
                }
            </dd>
            <dt class="col-sm-4">Đội tuyển</dt>
            <dd class="col-sm-8">@Model.Team.Name</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.IdPlayer" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div> 