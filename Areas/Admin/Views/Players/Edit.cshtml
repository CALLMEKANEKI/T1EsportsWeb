@model T1EsportsWeb.Models.T1Stat.Player

@{
    ViewData["Title"] = "Sửa Tuyển Thủ";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 900px;">
    <div class="card-header border-bottom border-secondary py-3">
        <h3 class="card-title fw-bold mb-0 text-white"><i class="fas fa-edit text-info me-2"></i>Sửa Thông Tin: @Model.IngameName</h3>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="IdPlayer" />
            <input type="hidden" asp-for="PhotoUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="IngameName" class="form-label fw-bold text-muted">Tên Ingame</label>
                    <input asp-for="IngameName" class="form-control bg-dark border-secondary text-white" required />
                    <span asp-validation-for="IngameName" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-bold text-muted">Tên Thật</label>
                    <input asp-for="FullName" class="form-control bg-dark border-secondary text-white" required />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label asp-for="Position" class="form-label fw-bold text-muted">Vị Trí</label>
                    <select asp-for="Position" class="form-select bg-dark border-secondary text-white" required>
                        <option value="Top">Top</option>
                        <option value="Jungle">Jungle</option>
                        <option value="Mid">Mid</option>
                        <option value="ADC">ADC</option>
                        <option value="Support">Support</option>
                        <option value="Coach">Coach</option>
                    </select>
                    <span asp-validation-for="Position" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="BirthDate" class="form-label fw-bold text-muted">Ngày Sinh</label>
                    <input asp-for="BirthDate" type="date" class="form-control bg-dark border-secondary text-white" />
                    <span asp-validation-for="BirthDate" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Country" class="form-label fw-bold text-muted">Quốc Gia</label>
                    <input asp-for="Country" class="form-control bg-dark border-secondary text-white" />
                    <span asp-validation-for="Country" class="text-danger"></span>
                </div>
            </div>

            <!-- Thêm dropdown chọn đội -->
            <div class="row mb-3">
                <div class="col-md-6">
                    <label asp-for="TeamId" class="form-label fw-bold text-muted">Đội Tuyển</label>
                    <select asp-for="TeamId" class="form-select bg-dark border-secondary text-white">
                        <option value="">-- Chọn đội --</option>
                        @foreach (var team in ViewBag.Teams)
                        {
                            <option value="@team.IdTeam">@team.Name</option>
                        }
                    </select>
                    <span asp-validation-for="TeamId" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-muted">Thay Đổi Ảnh</label>
                    <div class="d-flex align-items-center mb-2">
                        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
                        {
                            <img src="@Model.PhotoUrl" class="rounded border border-secondary me-3" style="width: 50px; height: 50px; object-fit: cover;" />
                        }
                        <input type="file" name="photoFile" class="form-control bg-dark border-secondary text-white" accept=".jpg,.jpeg,.png,.webp" />
                    </div>
                    <small class="text-muted">Bỏ trống nếu giữ nguyên ảnh cũ.</small>
                </div>
            </div>

            <hr class="border-secondary" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-info px-4 fw-bold text-white"><i class="fas fa-save me-2"></i>Cập Nhật</button>
                <a asp-action="Index" class="btn btn-outline-light px-4">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}