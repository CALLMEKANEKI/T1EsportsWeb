@model T1EsportsWeb.Models.T1Stat.Player

@{
    ViewData["Title"] = "Xóa Tuyển Thủ";
    Layout = "_AdminLayout";
}

<div class="alert alert-danger border-danger mb-4 d-flex align-items-center" role="alert" style="background: rgba(227, 0, 43, 0.1); color: #ff6b6b; max-width: 600px;">
    <i class="fas fa-exclamation-triangle fa-2x me-3"></i>
    <div>
        <h5 class="alert-heading fw-bold mb-1">Cảnh báo nguy hiểm!</h5>
        <p class="mb-0">Bạn có chắc chắn muốn xóa vĩnh viễn tuyển thủ <strong>@Model.IngameName</strong>? Toàn bộ dữ liệu trận đấu liên quan đến tuyển thủ này sẽ bị ảnh hưởng.</p>
    </div>
</div>

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 600px;">
    <div class="card-body p-4 text-center">
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <img src="@Model.PhotoUrl" alt="@Model.IngameName" class="rounded-circle border border-secondary p-1 mb-3 opacity-50" style="width: 120px; height: 120px; object-fit: cover; filter: grayscale(100%);" />
        }
        else
        {
            <i class="fas fa-user-times text-secondary fa-4x mb-3 opacity-50"></i>
        }

        <h3 class="fw-bold text-white mb-1">@Model.IngameName</h3>
        <p class="text-muted mb-4">Vị trí: @Model.Position | Đội: @(Model.Team?.Name ?? "Không có")</p>

        <hr class="border-secondary my-4" />
        <form asp-action="Delete" method="post" class="d-flex justify-content-center gap-2">
            <input type="hidden" asp-for="IdPlayer" />
            <button type="submit" class="btn btn-danger px-4 fw-bold"><i class="fas fa-trash-alt me-2"></i>Xác nhận Xóa</button>
            <a asp-action="Index" class="btn btn-outline-light px-4">Hủy bỏ</a>
        </form>
    </div>
</div>