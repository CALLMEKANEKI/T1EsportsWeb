@model T1EsportsWeb.Models.T1Stat.Player

@{
    ViewData["Title"] = "Xóa tuyển thủ";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Xóa tuyển thủ</h1>

<div class="alert alert-danger">
    <h3>Bạn có chắc chắn muốn xóa tuyển thủ này?</h3>
</div>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h4 class="card-title">@Model.IngameName</h4>
        <dl class="row">
            <dt class="col-sm-4">Tên thật</dt>
            <dd class="col-sm-8">@Model.FullName</dd>

            <dt class="col-sm-4">Vị trí</dt>
            <dd class="col-sm-8">@Model.Position</dd>
        </dl>
    </div>
    <div class="card-footer">
        <form asp-action="Delete">
            <input type="hidden" asp-for="IdPlayer" />
            <input type="submit" value="Xóa" class="btn btn-danger" />
            <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
        </form>
    </div>
</div>