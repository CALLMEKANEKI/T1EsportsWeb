@model IEnumerable<T1EsportsWeb.Models.T1Stat.Tournament>

@{
    ViewData["Title"] = "Danh sách giải đấu";
    Layout = "_AdminLayout";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchName = ViewBag.SearchName ?? "";
    int? year = ViewBag.Year;
    string region = ViewBag.Region ?? "";
    string isT1winner = ViewBag.IsT1winner ?? "";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-trophy me-2" style="color: #00ffd0;"></i>Quản Lý Giải Đấu</h2>
        <p class="text-muted small mb-0">Quản lý danh sách các giải đấu và thành tích của T1.</p>
    </div>
    <a asp-area="Admin" asp-action="Create" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">
        <i class="fas fa-plus me-2"></i>Thêm giải mới
    </a>
</div>

<div class="card border-0 mb-4 shadow-sm" style="background-color: #1e1e2d;">
    <div class="card-body">
        <div class="row g-3 align-items-end">
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold">TÊN GIẢI ĐẤU</label>
                <input type="text" name="searchName" class="form-control border-0 bg-dark text-white"
                       placeholder="Tìm tên giải..." value="@searchName" onchange="submitFilter()" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold">NĂM TỔ CHỨC</label>
                <input type="number" name="year" class="form-control border-0 bg-dark text-white"
                       placeholder="VD: 2023" value="@year" onchange="submitFilter()" />
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold">KHU VỰC</label>
                <select name="region" class="form-select border-0 bg-dark text-white" onchange="submitFilter()">
                    <option value="">-- Tất cả --</option>
                    <option value="KR" selected="@(region == "KR")">Hàn Quốc (KR)</option>
                    <option value="INT" selected="@(region == "INT")">Quốc tế (INT)</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label text-muted small fw-bold">T1 VÔ ĐỊCH</label>
                <select name="isT1winner" class="form-select border-0 bg-dark text-white" onchange="submitFilter()">
                    <option value="">-- Tất cả --</option>
                    <option value="Win" selected="@(isT1winner == "Win")">Vô Địch (Win)</option>
                    <option value="Loss" selected="@(isT1winner == "Loss")">Không (Loss)</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="button" onclick="submitFilter()" class="btn btn-success flex-grow-1 fw-bold">Tìm kiếm</button>
                <a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary px-3" title="Xóa lọc">
                    <i class="fas fa-redo"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="color: #e4e6ef;">
            <thead style="background-color: #2b2b40; color: #a1a5b7;">
                <tr>
                    <th class="ps-4 py-3 border-0">ID</th>
                    <th class="py-3 border-0">TÊN GIẢI ĐẤU</th>
                    <th class="py-3 border-0">NĂM</th>
                    <th class="py-3 border-0">KHU VỰC</th>
                    <th class="py-3 border-0">T1 VÔ ĐỊCH</th>
                    <th class="py-3 border-0">NHÀ VÔ ĐỊCH</th>
                    <th class="text-end pe-4 py-3 border-0">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #2b2b40;">
                            <td class="ps-4 text-muted">#@item.IdTournament</td>
                            <td class="py-3 fw-bold text-white fs-6">@item.Name</td>
                            <td class="py-3 text-muted">@item.Year</td>
                            <td class="py-3">
                                @if (item.Region == "KR")
                                {
                                    <span class="badge bg-soft-info text-info rounded-pill px-3 py-2" style="background: rgba(13, 202, 240, 0.1);">
                                        <i class="fas fa-map-marker-alt me-1"></i>Hàn Quốc
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-soft-primary text-primary rounded-pill px-3 py-2" style="background: rgba(13, 110, 253, 0.1);">
                                        <i class="fas fa-globe-asia me-1"></i>Quốc tế
                                    </span>
                                }
                            </td>
                            <td class="py-3">
                                @if (item.IsT1winner == "Win" || item.IsT1winner == "YES" || item.IsT1winner == "true")
                                {
                                    <span class="badge rounded-pill px-3 py-2" style="background-color: rgba(227, 0, 43, 0.1); color: #e3002b; border: 1px solid rgba(227, 0, 43, 0.2);">
                                        <i class="fas fa-crown me-1"></i> Vô Địch
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted"><i class="fas fa-times me-1"></i> Không</span>
                                }
                            </td>
                            <td class="py-3 text-warning fw-bold">@item.Winner</td>
                            <td class="text-end pe-4 py-3">
                                <div class="btn-group gap-2">
                                    <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.IdTournament"
                                       class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold">
                                        <i class="fas fa-edit me-1"></i>Sửa
                                    </a>
                                    <a asp-area="Admin" asp-action="Details" asp-route-id="@item.IdTournament"
                                       class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold">
                                        <i class="fas fa-eye me-1"></i>Xem
                                    </a>
                                    <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.IdTournament"
                                       class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                        <i class="fas fa-trash me-1"></i>Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <i class="fas fa-trophy fs-1 mb-3 opacity-25"></i>
                            <p class="text-muted">Không tìm thấy giải đấu nào!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link bg-dark border-secondary text-white" asp-area="Admin" asp-action="Index"
                   asp-route-page="@(currentPage - 1)" asp-route-searchName="@searchName"
                   asp-route-region="@region" asp-route-year="@year" asp-route-isT1winner="@isT1winner">«</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link @(i == currentPage ? "bg-danger border-danger" : "bg-dark border-secondary text-white")"
                       asp-area="Admin" asp-action="Index" asp-route-page="@i"
                       asp-route-searchName="@searchName" asp-route-region="@region" asp-route-year="@year" asp-route-isT1winner="@isT1winner">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link bg-dark border-secondary text-white" asp-area="Admin" asp-action="Index"
                   asp-route-page="@(currentPage + 1)" asp-route-searchName="@searchName"
                   asp-route-region="@region" asp-route-year="@year" asp-route-isT1winner="@isT1winner">»</a>
            </li>
        </ul>
    </nav>
}

<script>
    function submitFilter() {
        var url = new URL(window.location.href);

        var searchName = document.querySelector('input[name="searchName"]')?.value;
        if (searchName) url.searchParams.set('searchName', searchName);
        else url.searchParams.delete('searchName');

        var region = document.querySelector('select[name="region"]')?.value;
        if (region) url.searchParams.set('region', region);
        else url.searchParams.delete('region');

        var year = document.querySelector('input[name="year"]')?.value;
        if (year) url.searchParams.set('year', year);
        else url.searchParams.delete('year');

        var isT1winner = document.querySelector('select[name="isT1winner"]')?.value;
        if (isT1winner) url.searchParams.set('isT1winner', isT1winner);
        else url.searchParams.delete('isT1winner');

        window.location.href = url.pathname + url.search;
    }
</script>