@model IEnumerable<T1EsportsWeb.Models.T1Stat.Tournament>

@{
    ViewData["Title"] = "Danh sách giải đấu";
    

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchName = ViewBag.SearchName ?? "";
    int? year = ViewBag.Year;
    string region = ViewBag.Region ?? "";
    string? isT1winner = ViewBag.IsT1winner;
}

<h1>Quản lý giải đấu</h1>

<p>
    <a asp-area="Admin" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm mới</a>
</p>

<!-- Form lọc -->
<div class="row mb-3 g-2">
    <div class="col-md-3">
        <form asp-area="Admin" asp-action="Index" method="get" id="filterForm">
            <div class="input-group">
                <input type="text" name="searchName" class="form-control" placeholder="Tên giải..." value="@searchName" />
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Tìm</button>
                <a asp-area="Admin" asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
    <div class="col-md-2">
        <input type="number" name="year" class="form-control" placeholder="Năm" value="@year" onchange="submitFilter()" />
    </div>
    <div class="col-md-2">
        <select name="region" class="form-control" onchange="submitFilter()">
            <option value="">-- Khu vực --</option>
            <option value="KR" selected="@(region == "KR")">KR</option>
            <option value="INT" selected="@(region == "INT")">INT</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="isT1winner" class="form-control" onchange="submitFilter()">
            <option value="">-- T1 vô địch? --</option>
            @if (isT1winner == "YES")
            {
                <option value="Win" selected>Yes</option>
            }
            else
            {
                <option value="Win">Win</option>
            }
            @if (isT1winner == "NO")
            {
                <option value="Loss" selected>No</option>
            }
            else
            {
                <option value="Loss">Loss</option>
            }
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-dark table-hover align-middle">
        <thead>
            <tr>
                <th>Tên giải</th>
                <th>Năm</th>
                <th>Khu vực</th>
                <th>T1 vô địch?</th>
                <th>Đội vô địch</th>
                <th style="width: 200px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>@item.Year</td>
                    <td>@item.Region</td>
                    <td>@item.IsT1winner</td>
                    <td>@item.Winner</td>
                    <td>
                        <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.IdTournament" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Sửa
                        </a>
                        <a asp-area="Admin" asp-action="Details" asp-route-id="@item.IdTournament" class="btn btn-sm btn-info">
                            <i class="fas fa-info-circle"></i> Chi tiết
                        </a>
                        <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.IdTournament" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@(currentPage - 1)"
                   asp-route-searchName="@searchName" asp-route-year="@year" asp-route-region="@region" asp-route-isT1winner="@isT1winner">«</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@i"
                       asp-route-searchName="@searchName" asp-route-year="@year" asp-route-region="@region" asp-route-isT1winner="@isT1winner">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@(currentPage + 1)"
                   asp-route-searchName="@searchName" asp-route-year="@year" asp-route-region="@region" asp-route-isT1winner="@isT1winner">»</a>
            </li>
        </ul>
    </nav>
}

<script>
    function submitFilter() {
        var form = document.getElementById('filterForm');
        var url = new URL(window.location.href);
        // Lấy giá trị từ các select và input
        var yearInput = document.querySelector('input[name="year"]');
        if (yearInput && yearInput.value) {
            url.searchParams.set('year', yearInput.value);
        } else {
            url.searchParams.delete('year');
        }
        var regionSelect = document.querySelector('select[name="region"]');
        if (regionSelect && regionSelect.value) {
            url.searchParams.set('region', regionSelect.value);
        } else {
            url.searchParams.delete('region');
        }
        var isT1winnerSelect = document.querySelector('select[name="isT1winner"]');
        if (isT1winnerSelect && isT1winnerSelect.value) {
            url.searchParams.set('isT1winner', isT1winnerSelect.value);
        } else {
            url.searchParams.delete('isT1winner');
        }
        // Giữ lại searchName
        var searchNameInput = document.querySelector('input[name="searchName"]');
        if (searchNameInput && searchNameInput.value) {
            url.searchParams.set('searchName', searchNameInput.value);
        } else {
            url.searchParams.delete('searchName');
        }
        window.location.href = url.pathname + url.search;
    }
</script>