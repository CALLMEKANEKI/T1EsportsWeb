@model T1EsportsWeb.Models.T1Stat.Tournament

@{
    ViewData["Title"] = "Chi tiết giải đấu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Chi tiết giải đấu</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <dl class="row">
            <dt class="col-sm-4">Năm</dt>
            <dd class="col-sm-8">@Model.Year</dd>

            <dt class="col-sm-4">Khu vực</dt>
            <dd class="col-sm-8">@Model.Region</dd>

            <dt class="col-sm-4">T1 vô địch?</dt>
            <dd class="col-sm-8">@Model.IsT1winner</dd>

            <dt class="col-sm-4">Đội vô địch</dt>
            <dd class="col-sm-8">@Model.Winner</dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.IdTournament" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>