@model T1EsportsWeb.Models.T1Stat.Tournament

@{
    ViewData["Title"] = "Chi Tiết Giải Đấu";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 600px;">
    <div class="card-header border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0 text-white"><i class="fas fa-eye text-primary me-2"></i>Chi Tiết Giải Đấu</h3>
        <span class="badge bg-secondary fs-6">ID: #@Model.IdTournament</span>
    </div>
    <div class="card-body p-4 text-center">
        <div class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center border border-2 border-warning mb-3 shadow" style="width: 100px; height: 100px;">
            <i class="fas fa-trophy text-warning fa-3x"></i>
        </div>
        <h2 class="fw-bold text-white mb-0">@Model.Name</h2>
        <h4 class="text-muted mb-4">Năm: @Model.Year</h4>

        <div class="row text-start bg-dark rounded p-3 mb-4 mx-2">
            <div class="col-6 mb-2">
                <span class="text-muted small fw-bold d-block">KHU VỰC</span>
                <span class="fs-5">@(Model.Region == "KR" ? "Hàn Quốc (KR)" : "Quốc Tế (INT)")</span>
            </div>
            <div class="col-6 mb-2">
                <span class="text-muted small fw-bold d-block">ĐỘI VÔ ĐỊCH</span>
                <span class="fs-5 text-warning fw-bold">@(string.IsNullOrEmpty(Model.Winner) ? "Chưa xác định" : Model.Winner)</span>
            </div>
            <div class="col-12 mt-2 pt-2 border-top border-secondary">
                <span class="text-muted small fw-bold d-block">TRẠNG THÁI CỦA T1</span>
                @if (Model.IsT1winner == "YES")
                {
                    <span class="badge bg-success fs-6 mt-1 px-3 py-2"><i class="fas fa-crown me-2"></i>VÔ ĐỊCH</span>
                }
                else if (Model.IsT1winner == "NO")
                {
                    <span class="badge bg-danger fs-6 mt-1 px-3 py-2"><i class="fas fa-times-circle me-2"></i>THẤT BẠI</span>
                }
                else
                {
                    <span class="badge bg-secondary fs-6 mt-1 px-3 py-2">Đang thi đấu / Chưa rõ</span>
                }
            </div>
        </div>

        <div class="d-flex justify-content-center gap-2">
            <a asp-action="Edit" asp-route-id="@Model.IdTournament" class="btn btn-info px-4 fw-bold text-white"><i class="fas fa-edit me-2"></i>Sửa</a>
            <a asp-action="Index" class="btn btn-outline-light px-4"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
        </div>
    </div>
</div>