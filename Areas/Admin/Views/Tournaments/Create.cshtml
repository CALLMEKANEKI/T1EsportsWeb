@model T1EsportsWeb.Models.T1Stat.Tournament

@{
    ViewData["Title"] = "Thêm Giải Đấu";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 800px;">
    <div class="card-header border-bottom border-secondary py-3">
        <h3 class="card-title fw-bold mb-0 text-white"><i class="fas fa-trophy text-warning me-2"></i>Thêm Giải Đấu Mới</h3>
    </div>
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row mb-3">
                <div class="col-md-8">
                    <label asp-for="Name" class="form-label fw-bold text-muted">Tên Giải Đấu <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-control bg-dark border-secondary text-white" placeholder="VD: LCK Mùa Xuân, Worlds..." required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Year" class="form-label fw-bold text-muted">Năm <span class="text-danger">*</span></label>
                    <input asp-for="Year" type="number" class="form-control bg-dark border-secondary text-white" placeholder="VD: 2024" required />
                    <span asp-validation-for="Year" class="text-danger"></span>
                </div>
            </div>

            <div class="row mb-4">
                <div class="col-md-4">
                    <label asp-for="Region" class="form-label fw-bold text-muted">Khu Vực</label>
                    <select asp-for="Region" class="form-select bg-dark border-secondary text-white">
                        <option value="">-- Chọn khu vực --</option>
                        <option value="KR">Hàn Quốc (KR)</option>
                        <option value="INT">Quốc Tế (INT)</option>
                    </select>
                    <span asp-validation-for="Region" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="IsT1winner" class="form-label fw-bold text-muted">T1 Vô Địch?</label>
                    <select asp-for="IsT1winner" class="form-select bg-dark border-secondary text-white">
                        <option value="">-- Chọn --</option>
                        <option value="YES">Vô Địch (Win)</option>
                        <option value="NO">Thất Bại (Loss)</option>
                    </select>
                    <span asp-validation-for="IsT1winner" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Winner" class="form-label fw-bold text-muted">Đội Vô Địch</label>
                    <input asp-for="Winner" class="form-control bg-dark border-secondary text-white" placeholder="Tên đội vô địch..." />
                    <span asp-validation-for="Winner" class="text-danger"></span>
                </div>
            </div>

            <hr class="border-secondary" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-warning px-4 fw-bold text-dark"><i class="fas fa-save me-2"></i>Lưu Giải Đấu</button>
                <a asp-action="Index" class="btn btn-outline-light px-4">Hủy</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}