@model T1EsportsWeb.Models.T1Stat.Tournament

@{
    ViewData["Title"] = "Sửa giải đấu";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Sửa giải đấu</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="IdTournament" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Year" class="control-label"></label>
                <input asp-for="Year" class="form-control" />
                <span asp-validation-for="Year" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Region" class="control-label"></label>
                <input asp-for="Region" class="form-control" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="IsT1winner" class="control-label">T1 vô địch?</label>
                <select asp-for="IsT1winner" class="form-control">
                    <option value="">-- Chọn --</option>
                    <option value="Win">Win</option>
                    <option value="Loss">Loss</option>
                </select>
                <span asp-validation-for="IsT1winner" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Winner" class="control-label">Đội vô địch</label>
                <input asp-for="Winner" class="form-control" />
                <span asp-validation-for="Winner" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-area="Admin" asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}