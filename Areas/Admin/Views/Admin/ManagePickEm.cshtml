@model IEnumerable<T1EsportsWeb.Models.PickEmMatch>
@{
    ViewData["Title"] = "Quản lý Oracle Pick'Em";
}

<style>
    /* CSS TOAST ĐỒNG BỘ TỪ T1 SHOP */
    .t1-toast {
        position: fixed;
        bottom: 40px;
        right: 40px;
        background-color: #1e1e2d;
        border: 1px solid #2b2b40;
        border-left: 4px solid #00e676;
        padding: 15px 25px;
        border-radius: 12px;
        box-shadow: 0 15px 40px rgba(0,0,0,0.6);
        display: flex;
        align-items: center;
        gap: 18px;
        z-index: 9999;
        transform: translateX(calc(100% + 50px));
        transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    }

        .t1-toast.show {
            transform: translateX(0);
        }

    .toast-icon {
        color: #00e676;
        font-size: 2.2rem;
        display: flex;
        align-items: center;
    }

    .t1-toast.show .toast-icon {
        animation: scaleIn 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) both;
    }

    @@keyframes scaleIn {
        0% {
            transform: scale(0);
        }

        100% {
            transform: scale(1);
        }
    }
</style>

<div class="container-fluid mt-4">
    <div class="mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1 text-white"><i class="fas fa-gamepad me-2" style="color: #ff3c00;"></i>Quản lý Pick'Em</h2>
            <p class="text-muted">Tạo trận đấu, chốt tỉ số và phát T1 Points cho người chơi.</p>
        </div>
        <div>
            <button class="btn btn-danger fw-bold rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#addMatchModal">
                <i class="fas fa-plus me-1"></i> THÊM TRẬN ĐẤU
            </button>
        </div>
    </div>

    <div class="card p-0 border-0 shadow-sm mb-5" style="background-color: #1e1e2d;">
        <div class="card-header bg-transparent border-bottom p-4 d-flex justify-content-between align-items-center" style="border-color: #2b2b40 !important;">
            <h5 class="fw-bold mb-0 text-white"><i class="fas fa-list-ul me-2 text-warning"></i>Danh sách trận đấu</h5>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" style="color: #e4e6ef;">
                    <thead style="background-color: #2b2b40; color: #a1a5b7;">
                        <tr class="text-center">
                            <th class="py-3 border-0">ID</th>
                            <th class="py-3 border-0 text-start">Giải đấu & Thời gian</th>
                            <th class="py-3 border-0">Trận đấu</th>
                            <th class="py-3 border-0">Trạng thái</th>
                            <th class="py-3 border-0">Tỉ số thực tế</th>
                            <th class="py-3 border-0 text-end pe-4">Hành động</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var match in Model)
                            {
                                <tr style="border-bottom: 1px solid #2b2b40;" class="text-center">
                                    <td class="py-3 fw-bold" style="color: #a1a5b7;">#@match.Id</td>

                                    <td class="py-3 text-start">
                                        <div class="fw-bold text-info">@match.TournamentName</div>
                                        <div style="font-size: 0.85rem; color: #a1a5b7;"><i class="far fa-clock me-1"></i>@match.MatchTime.ToString("dd/MM/yyyy - HH:mm")</div>
                                    </td>

                                    <td class="py-3">
                                        <span class="fw-bold text-danger">T1</span>
                                        <span class="badge bg-dark border border-secondary mx-2">VS</span>
                                        <span class="fw-bold text-white">@match.OpponentName</span>
                                    </td>

                                    <td class="py-3">
                                        @if (match.IsLocked || DateTime.Now >= match.MatchTime)
                                        {
                                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger">Đã Khóa</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success">Đang Mở</span>
                                        }
                                    </td>

                                    <td class="py-3">
                                        @if (match.IsRewarded)
                                        {
                                            <span class="fw-bold text-success fs-5">@match.ActualScore</span>
                                        }
                                        else
                                        {
                                            <select class="form-select form-select-sm text-center mx-auto" style="width: 100px; background-color: #151521; color: #fff; border-color: #2b2b40;" id="real_score_@match.Id">
                                                <option value="">- Chọn -</option>
                                                <option value="2-0">2 - 0</option>
                                                <option value="2-1">2 - 1</option>
                                                <option value="1-2">1 - 2</option>
                                                <option value="0-2">0 - 2</option>
                                            </select>
                                        }
                                    </td>

                                    <td class="py-3 pe-4 text-end">
                                        <div class="d-flex justify-content-end align-items-center gap-2">
                                            @if (match.IsRewarded)
                                            {
                                                <span class="badge bg-success px-3 py-2"><i class="fas fa-check-double me-1"></i>ĐÃ TRẢ THƯỞNG</span>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-warning rounded-pill px-3 fw-bold" id="btn_reward_@match.Id" onclick="rewardMatch(@match.Id)">
                                                    <i class="fas fa-coins me-1"></i> CHỐT POINTS
                                                </button>
                                            }

                                            <button class="btn btn-sm btn-outline-danger rounded-circle d-flex justify-content-center align-items-center" style="width: 32px; height: 32px;" onclick="deleteMatch(@match.Id)" title="Xóa trận này">
                                                <i class="fas fa-trash-alt"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">Chưa có dữ liệu trận đấu.</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="addMatchModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="background-color: #1e1e2d; color: #fff; border: 1px solid #2b2b40;">
            <div class="modal-header border-bottom" style="border-color: #2b2b40 !important;">
                <h5 class="modal-title fw-bold"><i class="fas fa-plus-circle text-danger me-2"></i>Thêm trận đấu mới</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label text-muted">Tên giải đấu</label>
                    <input type="text" id="new_tournament" class="form-control" style="background-color: #151521; color: #fff; border-color: #2b2b40;" placeholder="VD: LCK Cup 26" value="LCK Cup 26">
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Tên đội đối thủ</label>
                    <input type="text" id="new_opponent" class="form-control" style="background-color: #151521; color: #fff; border-color: #2b2b40;">
                </div>
                <div class="mb-3">
                    <label class="form-label text-muted">Thời gian thi đấu</label>
                    <input type="datetime-local" id="new_time" class="form-control" style="background-color: #151521; color: #fff; border-color: #2b2b40;">
                </div>
            </div>
            <div class="modal-footer border-top" style="border-color: #2b2b40 !important;">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn btn-danger" onclick="addMatch()">Tạo Trận Đấu</button>
            </div>
        </div>
    </div>
</div>

<div id="t1Toast" class="t1-toast">
    <div id="toastIconContainer" class="toast-icon">
        <i id="toastIcon" class="fas fa-check-circle"></i>
    </div>
    <div class="pe-3">
        <strong id="toastTitle" class="d-block text-white" style="font-size: 1.15rem; letter-spacing: 0.5px;">Hệ Thống T1 Arcade</strong>
        <span id="toastMessage" class="text-muted" style="font-size: 0.95rem;"></span>
    </div>
</div>

@section Scripts {
    <script>
        // HÀM HIỂN THỊ TOAST THÔNG BÁO TỰ ĐỘNG
        function showToast(isSuccess, message) {
            var toast = document.getElementById('t1Toast');
            var msgSpan = document.getElementById('toastMessage');
            var icon = document.getElementById('toastIcon');
            var iconContainer = document.getElementById('toastIconContainer');

            msgSpan.innerText = message;

            if(isSuccess) {
                toast.style.borderLeftColor = "#00e676";
                iconContainer.style.color = "#00e676";
                icon.className = "fas fa-check-circle";
            } else {
                toast.style.borderLeftColor = "#e3002b";
                iconContainer.style.color = "#e3002b";
                icon.className = "fas fa-times-circle";
            }

            toast.classList.add('show');
            setTimeout(function() { toast.classList.remove('show'); }, 3000);
        }

        // HÀM 1: CẬP NHẬT & PHÁT LƯƠNG
        async function rewardMatch(matchId) {
            const realScore = document.getElementById(`real_score_${matchId}`).value;
            if (!realScore) {
                showToast(false, "Vui lòng chọn tỉ số thực tế trước khi chốt!");
                return;
            }

            if (!confirm(`XÁC NHẬN: Chốt kết quả là ${realScore} và tự động phát 100 T1 Points cho người đoán đúng? (Không thể hoàn tác)`)) return;

            const btn = document.getElementById(`btn_reward_${matchId}`);
            btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i>...';
            btn.disabled = true;

            try {
                const formData = new URLSearchParams();
                formData.append('matchId', matchId);
                formData.append('realScore', realScore);

                const response = await fetch('@Url.Action("RewardPickEmMatch", "Admin", new { area = "Admin" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    showToast(true, result.message);
                    // Đợi 1.5s cho Boss nhìn thấy Toast rồi mới reload
                    setTimeout(() => { location.reload(); }, 1500);
                } else {
                    showToast(false, "Lỗi: " + result.message);
                    btn.innerHTML = '<i class="fas fa-coins me-1"></i> CHỐT POINTS';
                    btn.disabled = false;
                }
            } catch (error) {
                showToast(false, "Lỗi kết nối mạng!");
                btn.innerHTML = '<i class="fas fa-coins me-1"></i> CHỐT POINTS';
                btn.disabled = false;
            }
        }

        // HÀM 2: THÊM TRẬN ĐẤU MỚI
        async function addMatch() {
            const tournamentName = document.getElementById('new_tournament').value;
            const opponentName = document.getElementById('new_opponent').value;
            const matchTime = document.getElementById('new_time').value;

            if (!tournamentName || !opponentName || !matchTime) {
                showToast(false, "Vui lòng điền đầy đủ thông tin!");
                return;
            }

            try {
                const formData = new URLSearchParams();
                formData.append('tournamentName', tournamentName);
                formData.append('matchTime', matchTime);
                formData.append('opponentName', opponentName);

                const response = await fetch('@Url.Action("AddPickEmMatch", "Admin", new { area = "Admin" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    // Đóng modal thủ công nếu muốn, hoặc cứ để reload giải quyết
                    const myModalEl = document.getElementById('addMatchModal');
                    const modal = bootstrap.Modal.getInstance(myModalEl);
                    if(modal) modal.hide();

                    showToast(true, result.message);
                    setTimeout(() => { location.reload(); }, 1500);
                } else {
                    showToast(false, "Lỗi: " + result.message);
                }
            } catch (error) {
                showToast(false, "Lỗi kết nối mạng!");
            }
        }

        // HÀM 3: XÓA TRẬN ĐẤU
        async function deleteMatch(matchId) {
            if (!confirm(`CẢNH BÁO: Boss có chắc chắn muốn XÓA trận đấu #${matchId}? Hành động này sẽ xóa luôn cả dự đoán của người chơi cho trận này!`)) return;

            try {
                const formData = new URLSearchParams();
                formData.append('matchId', matchId);

                const response = await fetch('@Url.Action("DeletePickEmMatch", "Admin", new { area = "Admin" })', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    body: formData
                });

                const result = await response.json();
                if (result.success) {
                    showToast(true, "Đã xóa trận đấu thành công!");
                    setTimeout(() => { location.reload(); }, 1500);
                } else {
                    showToast(false, "Lỗi: " + result.message);
                }
            } catch (error) {
                showToast(false, "Lỗi kết nối mạng!");
            }
        }
    </script>
}