@model IEnumerable<T1EsportsWeb.Models.Product>

@{
    ViewData["Title"] = "Danh sách Sản Phẩm";

}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-info"><i class="fas fa-boxes me-2"></i>Quản lý Kho Hàng</h2>
        <p class="text-muted">Xem, chỉnh sửa và xóa các sản phẩm trong T1 Shop.</p>
    </div>
    <div class="d-flex gap-2">
        <button id="btn-bulk-delete" class="btn btn-outline-warning fw-bold rounded-pill px-4 d-none">
            <i class="fas fa-trash-alt me-2"></i>Xóa mục đã chọn (<span id="selected-count">0</span>)
        </button>

        <a href="/Admin/AddProduct" class="btn btn-danger fw-bold rounded-pill px-4">
            <i class="fas fa-plus me-2"></i>Thêm Mới
        </a>
    </div>
</div>

@if (TempData["SuccessMsg"] != null)
{
    <div class="alert alert-success fw-bold text-center border border-success border-opacity-25" style="background-color: rgba(25, 135, 84, 0.1); color: #20c997;">
        <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMsg"]
    </div>
}

<div class="card p-0 overflow-hidden">
    <div class="table-responsive">
        <table class="table table-dark table-hover align-middle mb-0">
            <thead style="background-color: #2b2b40;">
                <tr>
                    <th class="ps-4 py-3 text-muted small text-uppercase">Hình ảnh</th>
                    <th class="py-3 text-muted small text-uppercase">Tên Sản Phẩm</th>
                    <th class="py-3 text-muted small text-uppercase">Giá bán</th>
                    <th class="py-3 text-muted small text-uppercase">Trong kho</th>
                    <th class="py-3 text-muted small text-uppercase">Size</th>
                    <th class="py-3 text-muted small text-uppercase text-end">Thao tác</th>
                    <th class="pe-4 py-3 text-center" style="width: 50px;">
                        <input class="form-check-input bg-dark border-secondary" type="checkbox" id="check-all" title="Chọn tất cả">
                    </th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="fas fa-box-open fs-1 mb-3"></i>
                            <p>Kho hàng đang trống. Hãy thêm sản phẩm mới!</p>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var item in Model)
                    {
                        var firstImage = string.IsNullOrEmpty(item.ImageUrl) ? "/images/default-product.png" : item.ImageUrl.Split(';')[0];

                        <tr>
                            <td class="ps-4 py-3">
                                <img src="@firstImage" alt="@item.ProductName" class="rounded border border-secondary" style="width: 50px; height: 50px; object-fit: cover;" />
                            </td>
                            <td class="py-3 fw-bold">@item.ProductName</td>
                            <td class="py-3 text-success fw-bold">@item.Price.ToString("N0") VNĐ</td>
                            <td class="py-3">
                                @if (item.StockQuantity > 0)
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-2 py-1">@item.StockQuantity chiếc</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger border border-danger border-opacity-25 px-2 py-1">Hết hàng</span>
                                }
                            </td>
                            <td class="py-3 text-muted">@(string.IsNullOrEmpty(item.Sizes) ? "Freesize" : item.Sizes)</td>
                            <td class="py-3 text-end">
                                <a href="/Admin/EditProduct/@item.ProductId" class="btn btn-sm btn-outline-warning rounded-circle me-1" title="Chỉnh sửa">
                                    <i class="fas fa-pen"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger rounded-circle btn-delete-product"
                                        data-url="/Admin/DeleteProduct/@item.ProductId"
                                        data-name="@item.ProductName" title="Xóa">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </td>
                            <td class="pe-4 py-3 text-center">
                                <input class="form-check-input bg-dark border-secondary item-checkbox" type="checkbox" value="@item.ProductId">
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // --- 1. CODE CHO NÚT XÓA TỪNG CÁI (Giữ nguyên) ---
        const deleteButtons = document.querySelectorAll('.btn-delete-product');
        deleteButtons.forEach(button => {
            button.addEventListener('click', function() {
                const deleteUrl = this.getAttribute('data-url');
                const productName = this.getAttribute('data-name');

                Swal.fire({
                    title: 'Xóa sản phẩm?',
                    text: `Bạn có chắc chắn muốn xóa "${productName}" không?`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e3002b',
                    cancelButtonColor: '#2b2b40',
                    confirmButtonText: '<i class="fas fa-trash me-2"></i>Xóa luôn!',
                    cancelButtonText: 'Hủy',
                    background: '#151521', color: '#ffffff',
                    customClass: { popup: 'border border-secondary border-opacity-25 rounded-4' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        window.location.href = deleteUrl;
                    }
                });
            });
        });

        // --- 2. CODE CHO TÍNH NĂNG CHECKBOX VÀ XÓA HÀNG LOẠT ---
        const checkAllBtn = document.getElementById('check-all');
        const itemCheckboxes = document.querySelectorAll('.item-checkbox');
        const bulkDeleteBtn = document.getElementById('btn-bulk-delete');
        const selectedCountSpan = document.getElementById('selected-count');

        // Hàm kiểm tra và cập nhật nút Xóa hàng loạt
        function updateBulkDeleteButton() {
            // Lọc ra những checkbox đang được tích
            const checkedBoxes = document.querySelectorAll('.item-checkbox:checked');
            const count = checkedBoxes.length;

            selectedCountSpan.textContent = count; // Cập nhật số lượng

            // Nếu có ít nhất 1 ô được tích thì hiện nút lên, ngược lại thì giấu đi
            if (count > 0) {
                bulkDeleteBtn.classList.remove('d-none');
            } else {
                bulkDeleteBtn.classList.add('d-none');
            }

            // Nếu tích đủ tất cả các ô nhỏ, thì tự động tích luôn ô "Chọn tất cả"
            checkAllBtn.checked = (count === itemCheckboxes.length && itemCheckboxes.length > 0);
        }

        // Bấm vào ô "Chọn tất cả" ở tiêu đề cột
        if(checkAllBtn) {
            checkAllBtn.addEventListener('change', function() {
                itemCheckboxes.forEach(checkbox => {
                    checkbox.checked = this.checked;
                });
                updateBulkDeleteButton();
            });
        }

        // Bấm vào từng ô checkbox nhỏ
        itemCheckboxes.forEach(checkbox => {
            checkbox.addEventListener('change', updateBulkDeleteButton);
        });

        // Xử lý khi bấm nút "Xóa mục đã chọn"
        if(bulkDeleteBtn) {
            bulkDeleteBtn.addEventListener('click', function() {
                // Gom tất cả các ID từ các ô đang được tích lại thành 1 mảng
                const selectedIds = Array.from(document.querySelectorAll('.item-checkbox:checked')).map(cb => parseInt(cb.value));

                Swal.fire({
                    title: 'Xóa Hàng Loạt?',
                    text: `Bạn chuẩn bị "tiễn" ${selectedIds.length} sản phẩm khỏi hệ thống. Hành động này không thể hoàn tác!`,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#e3002b',
                    cancelButtonColor: '#2b2b40',
                    confirmButtonText: '<i class="fas fa-skull me-2"></i>Đồng ý xóa hết!',
                    cancelButtonText: 'Hủy thao tác',
                    background: '#151521', color: '#ffffff',
                    customClass: { popup: 'border border-secondary border-opacity-25 rounded-4' }
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Gửi mảng ID về cho C# xử lý thông qua Fetch API (AJAX)
                        fetch('/Admin/DeleteMultiple', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(selectedIds)
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                // Xóa thành công thì tải lại trang để thấy thông báo xanh
                                window.location.reload();
                            } else {
                                Swal.fire('Lỗi!', data.message, 'error');
                            }
                        });
                    }
                });
            });
        }
    </script>
}