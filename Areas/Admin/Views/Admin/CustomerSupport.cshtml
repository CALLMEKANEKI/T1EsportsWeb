@model IEnumerable<T1EsportsWeb.Models.ChatMessage>
@{
    ViewData["Title"] = "Chăm sóc khách hàng";
    Layout = "_AdminLayout";
}

<div class="mb-4">
    <h2 class="fw-bold mb-1 text-white"><i class="fas fa-headset me-2" style="color: #f3c623;"></i>Chăm sóc khách hàng</h2>
    <p class="text-muted">Danh sách khách hàng đang cần hỗ trợ trực tuyến.</p>
</div>

<div class="card shadow-sm border-0" style="background-color: #1e1e2d;">
    <table class="table table-hover align-middle mb-0" style="color: #e4e6ef;">
        <thead style="background-color: #2b2b40; color: #a1a5b7;">
            <tr>
                <th class="ps-4 py-3 border-0">Khách hàng</th>
                <th class="py-3 border-0">Hoạt động cuối</th>
                <th class="text-end pe-4 py-3 border-0">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var chat in Model)
                {
                    <tr style="border-bottom: 1px solid #2b2b40;">
                        <td class="ps-4 py-3 fw-bold text-danger fs-5">
                            <i class="fas fa-user-circle me-2"></i>@chat.SenderUsername
                        </td>

                        <td class="py-3" style="color: #a1a5b7; font-weight: 500;">
                            <i class="far fa-clock me-1"></i> @chat.Timestamp.ToString("HH:mm - dd/MM")
                        </td>

                        <td class="text-end pe-4 py-3">
                            <a asp-area="Admin" asp-controller="Admin" asp-action="ChatRoom" asp-route-user="@chat.SenderUsername"
                               class="btn btn-outline-danger btn-sm rounded-pill px-4 fw-bold">
                                <i class="fas fa-comments me-1"></i> Mở phòng
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="3" class="text-center py-5 text-muted">
                        <i class="fas fa-inbox fs-1 mb-2 opacity-50"></i>
                        <p class="mb-0">Hiện không có khách hàng nào đang chờ hỗ trợ.</p>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>