@{
    ViewData["Title"] = "Tổng quan hệ thống";


    var recentOrders = ViewBag.RecentOrders as IEnumerable<T1EsportsWeb.Models.Order>;
    var recentVouchers = ViewBag.RecentVouchers as IEnumerable<T1EsportsWeb.Models.UserVoucher>;
    var recentChats = ViewBag.RecentChats as IEnumerable<T1EsportsWeb.Models.ChatMessage>;
    var recentProducts = ViewBag.RecentProducts as IEnumerable<T1EsportsWeb.Models.Product>;
}

<div class="mb-4 d-flex justify-content-between align-items-center">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-tachometer-alt me-2 text-danger"></i>Dashboard</h2>
        <p class="text-muted">Trung tâm điều khiển và giám sát toàn bộ hệ thống T1 Shop.</p>
    </div>
    <div>
        <span class="badge bg-danger bg-opacity-10 text-danger border border-danger px-3 py-2 fs-6">
            <i class="far fa-calendar-alt me-1"></i> @DateTime.Now.ToString("dd/MM/yyyy")
        </span>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card p-4 border-0 shadow-sm h-100" style="background-color: #1e1e2d; border-left: 4px solid #ffc107 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 fw-bold" style="color: #a1a5b7;">Đơn Hàng Chờ Duyệt</p>
                    <h2 class="fw-bold mb-0 text-white">@ViewBag.PendingOrdersCount</h2>
                </div>
                <div class="bg-warning bg-opacity-10 p-3 rounded-circle text-warning">
                    <i class="fas fa-box-open fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 border-0 shadow-sm h-100" style="background-color: #1e1e2d; border-left: 4px solid #e3002b !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 fw-bold" style="color: #a1a5b7;">Cảnh Báo Hết Hàng</p>
                    <h2 class="fw-bold mb-0 text-white">@ViewBag.LowStockCount <span class="fs-6 text-muted">sản phẩm</span></h2>
                </div>
                <div class="bg-danger bg-opacity-10 p-3 rounded-circle text-danger">
                    <i class="fas fa-exclamation-triangle fs-3"></i>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card p-4 border-0 shadow-sm h-100" style="background-color: #1e1e2d; border-left: 4px solid #0dcaf0 !important;">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="mb-1 fw-bold" style="color: #a1a5b7;">Tổng Người Dùng</p>
                    <h2 class="fw-bold mb-0 text-white">@ViewBag.TotalUsers</h2>
                </div>
                <div class="bg-info bg-opacity-10 p-3 rounded-circle text-info">
                    <i class="fas fa-users fs-3"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-lg-7">
        <div class="card p-0 border-0 shadow-sm h-100" style="background-color: #1e1e2d;">
            <div class="card-header bg-transparent border-bottom p-4 d-flex justify-content-between align-items-center" style="border-color: #2b2b40 !important;">
                <h5 class="fw-bold mb-0 text-white"><i class="fas fa-shopping-cart me-2 text-primary"></i>Đơn hàng mới nhất</h5>
                <a href="/Admin/OrderList" class="btn btn-sm btn-outline-primary rounded-pill px-3">Xem tất cả</a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="color: #e4e6ef;">
                        <thead style="background-color: #2b2b40; color: #a1a5b7;">
                            <tr>
                                <th class="ps-4 py-3 border-0">Khách hàng</th>
                                <th class="py-3 border-0">Thời gian</th>
                                <th class="py-3 border-0">Trạng thái</th>
                                <th class="pe-4 py-3 border-0 text-end">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (recentOrders != null && recentOrders.Any())
                            {
                                foreach (var order in recentOrders)
                                {
                                    <tr style="border-bottom: 1px solid #2b2b40;">
                                        <td class="ps-4 py-3 fw-bold">@order.Username</td>
                                        <td class="py-3" style="color: #a1a5b7;">@order.OrderDate.ToString("HH:mm - dd/MM")</td>
                                        <td class="py-3">
                                            @if (order.Status == "Chờ xử lý")
                                            {
                                                <span class="badge bg-warning text-dark">Chờ xử lý</span>
                                            }
                                            else if (order.Status == "Đã xác nhận")
                                            {

                                                <span class="badge bg-info text-dark">Đã xác nhận</span>
                                            }
                                            else if (order.Status == "Đang giao hàng")
                                            {

                                                <span class="badge bg-primary">Đang giao</span>
                                            }
                                            else
                                            {

                                                <span class="badge bg-success">Hoàn thành</span>
                                            }
                                        </td>
                                        <td class="pe-4 py-3 text-end">
                                            <a href="/Admin/OrderDetail/@order.OrderId" class="btn btn-sm btn-outline-light rounded-pill">Xem</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr><td colspan="4" class="text-center py-5 text-muted">Chưa có đơn hàng nào.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card p-0 border-0 shadow-sm flex-fill" style="background-color: #1e1e2d;">
            <div class="card-header bg-transparent border-bottom p-3 px-4 d-flex justify-content-between align-items-center" style="border-color: #2b2b40 !important;">
                <h6 class="fw-bold mb-0 text-white"><i class="fas fa-comment-dots me-2 text-danger"></i>Chat hỗ trợ gần đây</h6>
                <a href="/Admin/CustomerSupport" style="font-size: 0.8rem; text-decoration: none; color: #0dcaf0;">Xem tất cả</a>
            </div>
            <div class="card-body p-3">
                @if (recentChats != null && recentChats.Any())
                {
                    <div class="d-flex flex-column gap-2">
                        @foreach (var chat in recentChats)
                        {
                            <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background-color: #151521; border: 1px solid #2b2b40;">
                                <div class="d-flex align-items-center">
                                    <div class="bg-danger bg-opacity-10 text-danger rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 35px; height: 35px;">
                                        <i class="fas fa-user"></i>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-white mb-0" style="font-size: 0.9rem;">@chat.SenderUsername</div>
                                        <div style="font-size: 0.75rem; color: #a1a5b7;">@chat.Timestamp.ToString("HH:mm - dd/MM")</div>
                                    </div>
                                </div>
                                <a href="/Admin/ChatRoom?user=@chat.SenderUsername" class="btn btn-sm btn-danger rounded-circle" style="width: 30px; height: 30px; padding: 0; line-height: 30px;"><i class="fas fa-reply"></i></a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-3 small">Hệ thống đang rảnh rỗi.</div>
                }
            </div>
        </div>

        <div class="card p-0 border-0 shadow-sm flex-fill" style="background-color: #1e1e2d;">
            <div class="card-header bg-transparent border-bottom p-3 px-4" style="border-color: #2b2b40 !important;">
                <h6 class="fw-bold mb-0 text-white"><i class="fas fa-ticket-alt me-2 text-warning"></i>Voucher vừa đổi</h6>
            </div>
            <div class="card-body p-3">
                @if (recentVouchers != null && recentVouchers.Any())
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var v in recentVouchers)
                        {
                            <li class="d-flex align-items-center mb-2 pb-2 border-bottom" style="border-color: #2b2b40 !important;">
                                <i class="fas fa-gift fs-4 text-warning me-3"></i>
                                <div>
                                    <div class="fw-bold text-white" style="font-size: 0.9rem;">@v.Username</div>
                                    <div style="font-size: 0.8rem; color: #a1a5b7;">Đã đổi voucher <span class="text-success fw-bold">Thành công</span></div>
                                </div>
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-center text-muted py-3 small">Chưa có lượt quy đổi nào.</div>
                }
            </div>
        </div>
    </div>
</div>

<div class="card p-0 border-0 shadow-sm mb-5" style="background-color: #1e1e2d;">
    <div class="card-header bg-transparent border-bottom p-4 d-flex justify-content-between align-items-center" style="border-color: #2b2b40 !important;">
        <h5 class="fw-bold mb-0 text-white"><i class="fas fa-boxes me-2 text-info"></i>Sản phẩm vừa nhập kho</h5>
        <a href="/Admin/ProductList" class="btn btn-sm btn-outline-info rounded-pill px-3">Quản lý kho</a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="color: #e4e6ef;">
                <thead style="background-color: #2b2b40; color: #a1a5b7;">
                    <tr>
                        <th class="ps-4 py-3 border-0">Sản phẩm</th>
                        <th class="py-3 border-0">Giá bán</th>
                        <th class="py-3 border-0">Tồn kho</th>
                        <th class="pe-4 py-3 border-0 text-end">Cập nhật</th>
                    </tr>
                </thead>
                <tbody>
                    @if (recentProducts != null && recentProducts.Any())
                    {
                        foreach (var p in recentProducts)
                        {
                            var firstImage = !string.IsNullOrEmpty(p.ImageUrl) ? p.ImageUrl.Split(';')[0] : "/images/default-product.png";
                            <tr style="border-bottom: 1px solid #2b2b40;">
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div style="width: 45px; height: 45px; overflow: hidden; border-radius: 8px; border: 1px solid #2b2b40; background-color: #fff;" class="me-3">
                                            <img src="@firstImage" alt="Img" style="width: 100%; height: 100%; object-fit: cover;">
                                        </div>
                                        <div class="fw-bold text-white text-truncate" style="max-width: 250px;">@p.ProductName</div>
                                    </div>
                                </td>
                                <td class="py-3 text-warning fw-bold">@p.Price.ToString("N0")₫</td>
                                <td class="py-3">
                                    @if (p.StockQuantity > 10)
                                    {
                                        <span class="text-success fw-bold"><i class="fas fa-check-circle me-1"></i>@p.StockQuantity</span>
                                    }
                                    else if (p.StockQuantity > 0)
                                    {

                                        <span class="text-warning fw-bold"><i class="fas fa-exclamation-triangle me-1"></i>@p.StockQuantity</span>
                                    }
                                    else
                                    {

                                        <span class="text-danger fw-bold"><i class="fas fa-times-circle me-1"></i>Hết hàng</span>
                                    }
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    <a href="/Admin/EditProduct/@p.ProductId" class="btn btn-sm btn-outline-light rounded-pill px-3">Sửa</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr><td colspan="4" class="text-center py-4 text-muted">Chưa có sản phẩm nào.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>