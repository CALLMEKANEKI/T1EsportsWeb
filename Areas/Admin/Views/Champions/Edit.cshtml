@model T1EsportsWeb.Models.T1Stat.Champion

@{
    ViewData["Title"] = "Sửa Thông Tin Tướng";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 800px;">
    <div class="card-header border-bottom border-secondary py-3">
        <h3 class="card-title fw-bold mb-0 text-white"><i class="fas fa-edit text-info me-2"></i>Sửa Tướng: @Model.Name</h3>
    </div>
    <div class="card-body p-4">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="IdChampion" />
            <input type="hidden" asp-for="ImageUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-4">
                <label asp-for="Name" class="form-label fw-bold text-muted">Tên Tướng</label>
                <input asp-for="Name" class="form-control bg-dark border-secondary text-white" required />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-muted">Ảnh Hiện Tại</label>
                <div class="mb-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded border border-secondary shadow" style="width: 80px; height: 80px; object-fit: cover;" />
                    }
                    else
                    {
                        <div class="rounded bg-dark d-inline-flex align-items-center justify-content-center border border-2 border-dashed border-secondary" style="width: 80px; height: 80px;">
                            <i class="fas fa-image text-muted fa-2x"></i>
                        </div>
                    }
                </div>

                <label class="form-label fw-bold text-muted">Thay Đổi Ảnh</label>
                <input type="file" name="imageFile" class="form-control bg-dark border-secondary text-white" accept="image/*" />
                <small class="text-muted">Chọn file mới nếu muốn ghi đè ảnh hiện tại.</small>
            </div>

            <hr class="border-secondary" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-info px-4 fw-bold text-white"><i class="fas fa-save me-2"></i>Cập Nhật</button>
                <a asp-action="Index" class="btn btn-outline-light px-4">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}