@model T1EsportsWeb.Models.T1Stat.Champion

@{
    ViewData["Title"] = "Sửa tướng";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<h1>Sửa tướng</h1>

<hr />
<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" enctype="multipart/form-data" method="post">
            <input type="hidden" asp-for="IdChampion" />
            <input type="hidden" asp-for="ImageUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group mb-3">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label>Ảnh hiện tại</label>
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <div>
                        <img src="@Model.ImageUrl" style="max-height: 100px;" />
                    </div>
                }
                <input type="file" name="imageFile" class="form-control" accept="image/*" />
                <small class="text-muted">Chọn file mới nếu muốn thay đổi.</small>
            </div>
            <div class="form-group">
                <input type="submit" value="Lưu" class="btn btn-primary" />
                <a asp-area="Admin" asp-action="Index" class="btn btn-secondary">Quay lại</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}