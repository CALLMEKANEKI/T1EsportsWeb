@model T1EsportsWeb.Models.T1Stat.Champion

@{
    ViewData["Title"] = "Chi Tiết Tướng";
    Layout = "_AdminLayout";
}

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d; color: white; max-width: 500px;">
    <div class="card-header border-bottom border-secondary py-3 d-flex justify-content-between align-items-center">
        <h3 class="card-title fw-bold mb-0 text-white"><i class="fas fa-eye text-primary me-2"></i>Chi Tiết Tướng</h3>
        <span class="badge bg-secondary fs-6">ID: #@Model.IdChampion</span>
    </div>
    <div class="card-body p-4 text-center">
        @if (!string.IsNullOrEmpty(Model.ImageUrl))
        {
            <img src="@Model.ImageUrl" alt="@Model.Name" class="rounded-circle border border-danger p-1 mb-3 shadow" style="width: 150px; height: 150px; object-fit: cover; background: #000;" />
        }
        else
        {
            <div class="rounded-circle bg-dark d-inline-flex align-items-center justify-content-center border border-2 border-dashed border-secondary mb-3" style="width: 150px; height: 150px;">
                <i class="fas fa-user-ninja text-muted fa-4x"></i>
            </div>
        }

        <h2 class="fw-bold text-white mb-4">@Model.Name</h2>

        <hr class="border-secondary" />
        <div class="d-flex justify-content-center gap-2 mt-4">
            <a asp-action="Edit" asp-route-id="@Model.IdChampion" class="btn btn-info px-4 fw-bold text-white"><i class="fas fa-edit me-2"></i>Sửa</a>
            <a asp-action="Index" class="btn btn-outline-light px-4"><i class="fas fa-arrow-left me-2"></i>Quay lại</a>
        </div>
    </div>
</div>