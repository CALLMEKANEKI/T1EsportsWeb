@model T1EsportsWeb.Models.T1Stat.Champion

@{
    ViewData["Title"] = "Chi tiết tướng";
}

<h1>Chi tiết tướng</h1>

<div class="card" style="max-width: 500px;">
    <div class="card-body">
        <h4 class="card-title">@Model.Name</h4>
        <dl class="row">
            <dt class="col-sm-4">Ảnh</dt>
            <dd class="col-sm-8">
                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="champion" style="max-height: 100px;" />
                }
                else
                {
                    <span class="text-muted">Chưa có</span>
                }
            </dd>
        </dl>
    </div>
    <div class="card-footer">
        <a asp-action="Edit" asp-route-id="@Model.IdChampion" class="btn btn-warning">Sửa</a>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </div>
</div>