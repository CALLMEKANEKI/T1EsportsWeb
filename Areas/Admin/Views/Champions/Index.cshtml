@model IEnumerable<T1EsportsWeb.Models.T1Stat.Champion>

@{
    ViewData["Title"] = "Danh sách tướng";
    Layout = "_AdminLayout"; // Bỏ .cshtml đi cho chuẩn quy tắc MVC

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchName = ViewBag.SearchName ?? "";
    bool? hasImage = ViewBag.HasImage;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1 text-white"><i class="fas fa-dragon me-2 text-danger"></i>Quản Lý Tướng</h2>
        <p class="text-muted small mb-0">Hệ thống lưu trữ và cập nhật chỉ số các vị tướng LMHT.</p>
    </div>
    <a asp-area="Admin" asp-action="Create" class="btn btn-danger rounded-pill px-4 shadow-sm fw-bold">
        <i class="fas fa-plus me-2"></i>Thêm tướng mới
    </a>
</div>

<div class="card border-0 mb-4 shadow-sm" style="background-color: #1e1e2d;">
    <div class="card-body">
        <form asp-area="Admin" asp-action="Index" method="get" id="filterForm" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label text-muted small fw-bold">TÌM KIẾM TÊN TƯỚNG</label>
                <div class="input-group">
                    <span class="input-group-text bg-dark border-0 text-muted"><i class="fas fa-search"></i></span>
                    <input type="text" name="searchName" class="form-control border-0 bg-dark text-white"
                           placeholder="Nhập tên tướng cần tìm..." value="@searchName" />
                </div>
            </div>
            <div class="col-md-3">
                <label class="form-label text-muted small fw-bold">LỌC DỮ LIỆU</label>
                <select name="hasImage" class="form-select border-0 bg-dark text-white" onchange="this.form.submit()">
                    <option value="">-- Tất cả ảnh --</option>
                    <option value="true" selected="@(hasImage == true)">Có hình ảnh</option>
                    <option value="false" selected="@(hasImage == false)">Thiếu hình ảnh</option>
                </select>
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-success flex-grow-1 fw-bold">Áp dụng lọc</button>
                <a asp-area="Admin" asp-action="Index" class="btn btn-outline-secondary px-3">
                    <i class="fas fa-redo"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm" style="background-color: #1e1e2d;">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" style="color: #e4e6ef;">
            <thead style="background-color: #2b2b40; color: #a1a5b7;">
                <tr>
                    <th class="ps-4 py-3 border-0">ID</th>
                    <th class="py-3 border-0">HÌNH ẢNH</th>
                    <th class="py-3 border-0">TÊN VỊ TƯỚNG</th>
                    <th class="py-3 border-0 text-center">TRẠNG THÁI DỮ LIỆU</th>
                    <th class="text-end pe-4 py-3 border-0">THAO TÁC</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr style="border-bottom: 1px solid #2b2b40;">
                            <td class="ps-4 text-muted">#@item.IdChampion</td>
                            <td class="py-3">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <div class="position-relative d-inline-block">
                                        <img src="@item.ImageUrl" alt="champion"
                                             class="rounded-circle border border-2 border-secondary"
                                             style="width: 50px; height: 50px; object-fit: cover;" />
                                    </div>
                                }
                                else
                                {
                                    <div class="rounded-circle bg-dark d-flex align-items-center justify-content-center border border-2 border-dashed border-secondary"
                                         style="width: 50px; height: 50px;">
                                        <i class="fas fa-image text-muted"></i>
                                    </div>
                                }
                            </td>
                            <td class="py-3 fw-bold text-white fs-5">@item.Name</td>
                            <td class="py-3 text-center">
                                @if (!string.IsNullOrEmpty(item.ImageUrl))
                                {
                                    <span class="badge rounded-pill bg-soft-success text-success px-3 py-2" style="background: rgba(40, 167, 69, 0.1);">
                                        <i class="fas fa-check-circle me-1"></i>Đủ ảnh
                                    </span>
                                }
                                else
                                {
                                    <span class="badge rounded-pill bg-soft-warning text-warning px-3 py-2" style="background: rgba(255, 193, 7, 0.1);">
                                        <i class="fas fa-exclamation-triangle me-1"></i>Thiếu ảnh
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4 py-3">
                                <div class="btn-group gap-2">
                                    <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.IdChampion"
                                       class="btn btn-sm btn-outline-info rounded-pill px-3 fw-bold">
                                        <i class="fas fa-edit me-1"></i>Sửa
                                    </a>
                                    <a asp-area="Admin" asp-action="Details" asp-route-id="@item.IdChampion"
                                       class="btn btn-sm btn-outline-light rounded-pill px-3 fw-bold">
                                        <i class="fas fa-eye me-1"></i>Xem
                                    </a>
                                    <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.IdChampion"
                                       class="btn btn-sm btn-outline-danger rounded-pill px-3 fw-bold">
                                        <i class="fas fa-trash me-1"></i>Xóa
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center py-5">
                            <i class="fas fa-search fs-1 mb-3 opacity-25"></i>
                            <p class="text-muted">Không tìm thấy vị tướng nào phù hợp!</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav aria-label="Page navigation" class="mt-4">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link bg-dark border-secondary text-white" asp-area="Admin" asp-action="Index"
                   asp-route-page="@(currentPage - 1)" asp-route-searchName="@searchName" asp-route-hasImage="@hasImage">
                    <i class="fas fa-chevron-left"></i>
                </a>
            </li>

            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link @(i == currentPage ? "bg-danger border-danger" : "bg-dark border-secondary text-white")"
                       asp-area="Admin" asp-action="Index" asp-route-page="@i"
                       asp-route-searchName="@searchName" asp-route-hasImage="@hasImage">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link bg-dark border-secondary text-white" asp-area="Admin" asp-action="Index"
                   asp-route-page="@(currentPage + 1)" asp-route-searchName="@searchName" asp-route-hasImage="@hasImage">
                    <i class="fas fa-chevron-right"></i>
                </a>
            </li>
        </ul>
    </nav>
}

@section Scripts {
    <script>
        // Hiệu ứng hover dòng bảng mượt mà hơn
        $(document).ready(function() {
            $('tr').hover(
                function() { $(this).css('background-color', '#2b2b40'); },
                function() { $(this).css('background-color', 'transparent'); }
            );
        });
    </script>
}