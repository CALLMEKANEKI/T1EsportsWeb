@model IEnumerable<T1EsportsWeb.Models.T1Stat.Champion>

@{
    ViewData["Title"] = "Danh sách tướng";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string searchName = ViewBag.SearchName ?? "";
    bool? hasImage = ViewBag.HasImage;
}

<h1>Quản lý tướng</h1>

<p>
    <a asp-area="Admin" asp-action="Create" class="btn btn-primary"><i class="fas fa-plus"></i> Thêm mới</a>
</p>

<!-- Form lọc -->
<div class="row mb-3">
    <div class="col-md-4">
        <form asp-area="Admin" asp-action="Index" method="get" id="filterForm">
            <div class="input-group">
                <input type="text" name="searchName" class="form-control" placeholder="Tìm theo tên..." value="@searchName" />
                <button type="submit" class="btn btn-primary"><i class="fas fa-search"></i> Tìm</button>
                <a asp-area="Admin" asp-action="Index" class="btn btn-secondary">Xóa lọc</a>
            </div>
        </form>
    </div>
    <div class="col-md-3">
        <select name="hasImage" class="form-control" onchange="submitFilter()">
            <option value="">-- Lọc theo ảnh --</option>
            <option value="true" selected="@(hasImage == true)">Có ảnh</option>
            <option value="false" selected="@(hasImage == false)">Không ảnh</option>
        </select>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-dark table-hover align-middle">
        <thead>
            <tr>
                <th>Tên tướng</th>
                <th>Ảnh</th>
                <th style="width: 200px;">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Name</td>
                    <td>
                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                        {
                            <img src="@item.ImageUrl" alt="champion" style="max-height: 40px;" />
                        }
                        else
                        {
                            <span class="text-muted">Chưa có</span>
                        }
                    </td>
                    <td>
                        <a asp-area="Admin" asp-action="Edit" asp-route-id="@item.IdChampion" class="btn btn-sm btn-warning">
                            <i class="fas fa-edit"></i> Sửa
                        </a>
                        <a asp-area="Admin" asp-action="Details" asp-route-id="@item.IdChampion" class="btn btn-sm btn-info">
                            <i class="fas fa-info-circle"></i> Chi tiết
                        </a>
                        <a asp-area="Admin" asp-action="Delete" asp-route-id="@item.IdChampion" class="btn btn-sm btn-danger">
                            <i class="fas fa-trash"></i> Xóa
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<!-- Phân trang -->
@if (totalPages > 1)
{
    <nav aria-label="Page navigation">
        <ul class="pagination justify-content-center">
            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-searchName="@searchName" asp-route-hasImage="@hasImage">«</a>
            </li>
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@i" asp-route-searchName="@searchName" asp-route-hasImage="@hasImage">@i</a>
                </li>
            }
            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link" asp-area="Admin" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-searchName="@searchName" asp-route-hasImage="@hasImage">»</a>
            </li>
        </ul>
    </nav>
}

<script>
    function submitFilter() {
        var select = document.querySelector('select[name="hasImage"]');
        var value = select.value;
        var url = new URL(window.location.href);
        if (value) {
            url.searchParams.set('hasImage', value);
        } else {
            url.searchParams.delete('hasImage');
        }
        window.location.href = url.pathname + url.search;
    }
</script>